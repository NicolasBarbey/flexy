{% set title = title|default('') %}
{% set selected = selected|default('profile') %}

<div class="AccountHero">
    <div class="AccountHero-breadcrumb">
        {% if breadcrumb|length %}
        {% include '@components/Molecules/Breadcrumb/Breadcrumb.html.twig' with {
            items: breadcrumb
        } %}
        {% endif %}
    </div>
    <div class="container flex flex-col items-center gap-10 my-12.5">
        <h1 class="h1">{{ title }}</h1>
        <ul class="AccountHero-links">
            {% for item in this.accountItems %}
            <li class="flex-1">
                {{ component('Flexy:Button',{
                    text: item.text,
                    href: item.href,
                    size: 'small',
                    sharp:true,
                    color: selected == item.slug ? 'invert' : 'secondary',
                    class: 'w-full h-full'
                }) }}
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
