<div class="PickupPointSearch-searchZone" {{ attributes }}>
    <div class="FieldWrapper flex flex-col gap-1 mb-4">
        <div class="FieldInput-header">
            <label for="pickup_address_address" class="FieldInput-label required">{{ 'Find a delivery address'|trans }}</label>
        </div>
        <div class="FieldInput-blockInput">
            <input type="search" placeholder="{{ 'e.g. City, Postcode'|trans }}" class="FieldInput-input" data-model="debounce(500)|query">
        </div>
    </div>
    <div class="flex gap-1 md:gap-5">
        {{ component('Flexy:Button',{
            text: 'List view'|trans,
            classes :'PickupPointSearch-buttonListView',
            sharp: true,
            icon_left: 'list',
            'data-action': 'live#action',
            'data-live-action-param': 'setView',
            'data-live-view-param': 'list',
        }) }}
        {{ component('Flexy:Button',{
            color: "secondary",
            text: 'Map view'|trans,
            classes :'PickupPointSearch-buttonListView',
            sharp: true,
            icon_left: 'pin-circle',
            'data-action': 'live#action',
            'data-live-action-param': 'setView',
            'data-live-view-param': 'map',
        }) }}
    </div>
    <div class="mt-5 paragraph-6">
        {{ this.pickupPoints|length }}
        {{ 'relay point(s) found'|trans }}
    </div>
    <div class="gap-10 mt-3 text-black xl:flex">
        {% for pickupService in pickupServices %}
            <label class="Checkbox items-center">
                <input type="checkbox" name="pickup" value='{{ pickupService.value }}'>
                <div class="checkmark">
                    <span>
                        {{ ux_icon('checkbox') }}
                    </span>
                </div>
                <span>
                    {{ pickupService.name }}
                </span>
                {% if pickupService.img %}
                    <span>
                        <img src='{{ pickupService.img }}' alt="Logo {{ pickupService.name }}" loading="lazy">
                    </span>
                {% endif %}
            </label>
        {% endfor %}
    </div>
    {% if this.view == 'list' %}
        <div class="PickupPointSearch-listView">
            <div class="flex flex-col gap-2 mt-6">
                {% for pickup in this.pickupPoints %}
                    {{ component('Flexy:PickupPoint', pickup|merge({
                        checked: this.selectedPickup == pickup.id
                    })) }}
                {% endfor %}
            </div>
        </div>
    {% endif %}
    {% if this.view == 'map' %}
        <div class="PickupPointSearch-mapView">
            {{ component('Flexy:PickupMap') }}
            <div class="mt-[10px]">
                {% if this.selectedPickup %}
                    {{ component('Flexy:PickupPoint', this.pickupPoints|find(p => p.id == this.selectedPickup)|merge({checked: true})) }}
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
