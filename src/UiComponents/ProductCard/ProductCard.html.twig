{% props
    imgWidth = 300,
    imgHeight = 300,
    reviewCount = 0
%}


{% if img is not defined and this.imageId is not null %}
	{% set img = {url: '/legacy-image-library/product_image_' ~ this.imageId ~ '/full/%5E*!386,280/0/default.webp', alt: this.product.title} %}
{% endif %}

{% if img is not defined %}
	{% set img = img|default({url: asset('dist/images/placeholder2.webp'), alt: ''}) %}
{% endif %}

<div class="ProductCard {{ attributes.render('class') }}" {{attributes}}>
	<div class="ProductCard-header">
		<div class="ProductCard-tagList">
			{% if this.isNew %}
				{{ include('@components/Molecules/Tag/Tag.html.twig', {customText: 'New'|trans, variant: 'vermillon'}) }}
			{% endif %}
			{% if this.isPromo %}
				{{ include('@components/Molecules/Tag/Tag.html.twig', {customText: this.promoRate|format_number(style: 'percent'), variant: 'error'}) }}
			{% endif %}
		</div>
		{# {{ component('WishList:WishListButton', {pseId: this.defaultPseId}) }} #}
	</div>
	<div class="ProductCard-mainContent">
		<a class="ProductCard-imgLink" href="{{ this.product.publicUrl }}">
			<figure class="ProductCard-img">
				<img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
			</figure>
		</a>
		<div class="ProductCard-desc">
			<a href="{{ this.product.publicUrl }}" class="ProductCard-title">{{ this.product.title }}</a>

			{% if this.product.chapo %}
				<div class="ProductCard-subTitle paragraph-3">{{ this.product.chapo }}</div>
			{% endif %}

			<div class="ProductCard-footer">
				{% if this.rate != null or this.product.colors|length > 0 %}
					<div class="ProductCard-footerLeft">
						{% if this.rate != null %}
							<div class="Rating">
								<div class="Rating-mark">
									{% for i in 1..5 %}
										{% if this.rate >= i %}
											<div>
												{{ ux_icon('star-full') }}
											</div>
										{% elseif this.rate <= i and this.rate > i - 1 %}
											<div>
												{{ ux_icon('star-half-empty') }}
											</div>
										{% else %}
											<div class="star-empty">
												{{ ux_icon('star-full') }}
											</div>
										{% endif %}
									{% endfor %}
								</div>
								<span class="Rating-reviewCount indication-small">
									{{ reviewCount }}
									{{ 'Reviews'|trans }}
								</span>
							</div>
						{% endif %}
						{% if this.product.colors|length > 0 %}
							<div class="Colors">
								{% set limit = 6 %}
								{% for color in this.product.colors %}
									{% if loop.index0 < limit %}
										<a href="#" class="Colors-item" style="background-color:{{ color }}"></a>
									{% else %}
										<div class="Colors-others">...</div>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
				{% endif %}
				{% if this.isPromo %}
					<div class="ProductCard-footerRight">
						<div class="ProductCard-price">{{ this.promoTaxedPrice|format_currency('EUR', locale: lang_code) }}</div>
						<div class="ProductCard-originalPrice">{{ this.taxedPrice|format_currency('EUR', locale: lang_code) }}</div>
					</div>
				{% else %}
					<div class="ProductCard-price">{{ this.taxedPrice|format_currency('EUR', locale: lang_code) }}</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
