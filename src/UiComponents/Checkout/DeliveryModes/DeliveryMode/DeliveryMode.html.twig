{% props icon = null %}
<div {{attributes.defaults({class: 'DeliveryMode DeliveryModule ' ~ (this.checked ? 'selected' : '') ~ type })}}>
	<label class='DeliveryMode-content'>
		{{ component('Flexy:Inputs:Radio', {
			'type': 'span',
			'value': this.moduleId,
			'name': 'delivery_mode',
			'input:data-action': 'live#emit',
			'input:data-live-event-param': constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutEvents::SET_DELIVERY_MODULE_OPTION'),
			'input:data-live-option-code-param': this.optionCode,
			'input:data-live-module-id-param': this.moduleId 
		}) }}

		<span>
			<div class='flex justify-between'>
				<div>
					<span class='DeliveryMode-title'>{{ this.title }}</span>
					{% if this.date %}
						<span class='DeliveryMode-description'>{{ 'Estimated delivery on'|trans }} {{ this.date }}</span>
					{% endif %}
				</div>
				<div class="w-12 h-12 text-theme-medium">
					{{ ux_icon(icon) }}
				</div>
			</div>
			<div class='flex items-center justify-between mt-6'>
				<span class='DeliveryMode-price'>{{ this.price|format_currency('EUR', locale: lang_code) }}</span>
				{% include '@components/Molecules/Tag/Tag.html.twig' with { icon: "carbone", customText: "TODO CO2" } %}
			</div>

            {% block content %}{% endblock %}

		</span>
	</label>
    {% block footer %}{% endblock %}
</div>
