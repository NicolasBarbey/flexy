<div {{attributes}}>

	

	{% if this.cart.totalItems  %}
		<div class='Checkout-main-header'>
			{{this.cart.totalItems}}
			{{ this.cart.totalItems <= 1 ? 'article'|trans : 'articles'|trans }}
		</div>
		{% if this.pendingDelete %}
		{% include "@UiComponents/CartItemDelete/CartItemDelete.html.twig" with this.pendingDelete only %}
		{% endif %}
		<div class='flex flex-col gap-4'>
			{% for item in this.cart.items %}
				{{ component('Flexy:CartItem', {cartItemId: item.id}) }}
			{% endfor %}
		</div>
	{% else %}
		<div class="my-8 text-center">
			{{ux_icon('empty', {width: 245, height: 185, class :'w-[245px] h-[185px] block mx-auto mb-[56px]'})}}
			<h1 class="mb-6 h3">{{'Your cart is empty'|trans}}</h1>
			{% include "@components/Molecules/Button/Button.html.twig" with {href:'/', text: "Back to the store"|trans, variant: "large" } %}
		</div>
	{% endif %}
</div>