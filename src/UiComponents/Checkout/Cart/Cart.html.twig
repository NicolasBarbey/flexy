<div {{  attributes.defaults(stimulus_controller('cart')) }}>


    {% if this.totalItems %}
        {% if this.itemHasNoStockMessage %}
            {% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {
                text: 'Your cart contains unvailable products'|trans,
                variant: 'error',
                withIcon: true,
                class:'mb-6'
            } %}
        {% endif %}
        {% if this.totalItems %}
            <div class="checkout-main-header">
                {{ this.totalItems }}
                {{ this.totalItems <= 1 ? 'item'|trans : 'items'|trans }}
            </div>
        {% endif %}
        {% if this.pendingDelete %}
            {{ include('@UiComponents/CartItemDelete/CartItemDelete.html.twig', this.pendingDelete, false) }}
        {% endif %}
        <div class="flex flex-col gap-5">
            {% for index, item in this.items %}
                {{ component('Flexy:CartItem', {
                    cartItem: item,
                    key: item.id,
                    index
                })
                }}
            {% endfor %}
        </div>
    {% else %}
        {% if this.pendingDelete %}
            {{ include('@UiComponents/CartItemDelete/CartItemDelete.html.twig', this.pendingDelete, false) }}
        {% endif %}
        <div class="my-8 text-center">
            {{ ux_icon('empty', {width: 245, height: 185, class: 'w-[245px] h-[185px] block mx-auto mb-[56px]'}) }}
            <h1 class="mb-6 h3">
                {{ 'Your cart is empty'|trans }}
            </h1>
            {{ component('Flexy:Button', {
                href: path('index'),
                text: 'Back to the store'|trans,
                size: 'large',
            }) }}
        </div>
    {% endif %}
</div>
