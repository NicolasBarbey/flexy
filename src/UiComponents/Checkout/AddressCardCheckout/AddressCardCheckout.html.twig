{% extends "@UiComponents/AddressCard/AddressCard.html.twig" %}

{% block bottom %}
    <button {% if disabled %} disabled {% endif %} class='hover:text-theme' type='button' data-action='live#emit' data-live-event-param='editAddress' data-live-id-param="{{ address.id }}">
        <span>{{ ux_icon("edit") }}</span>
        {{ 'Modify'|trans }}
    </button>
    {% if not isDefault %}
        <button {% if disabled %} disabled {% endif %} class='hover:text-theme{% if attributesDelete.class|default(' ') %} {{ attributesDelete.class }}{% endif %}' type='button' {% if attributesDelete['data-id']|default('') %} data-id="{{ attributesDelete['data-id'] }}" {% endif %} data-action='live#emit' data-live-event-param='deleteAddress' data-live-id-param="{{ address.id }}">
            <span>{{ ux_icon("delete") }}</span>
            {{ 'Delete'|trans }}
        </button>
    {% endif %}
{% endblock %}