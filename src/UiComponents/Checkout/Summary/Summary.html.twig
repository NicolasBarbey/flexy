<div {{ attributes }}>
        {% set totalItems = this.summary.item_count %}
        {% set subTotal = this.summary.raw_taxed_total_price|format_currency('EUR', locale: 'fr') %}
        {% set total = this.summary.total_taxed_price|format_currency('EUR', locale: 'fr') %}
        {% set tax = this.summary.total_tax_amount|format_currency('EUR', locale: 'fr') %}
        {% set taxed_postage = this.summary.taxed_postage ? this.summary.taxed_postage|format_currency('EUR', locale: 'fr') : null %}
        {% set taxed_discount = this.summary.taxed_discount ? this.summary.taxed_discount|format_currency('EUR', locale: 'fr') : null %}
        {% set discount = this.summary.discount ? this.summary.discount|format_currency('EUR', locale: 'fr') : null %}

        <div class="Summary">

            <div class="Summary-promo mb-4">
                {{ component('Flexy:Checkout:PromoCodeForm', { class: ''} )}}
            </div>

            <div class="Summary-list">
                <div class="Summary-line">
                    <div>
                        {{ 'Subtotal'|trans }}
                        <span class="font-normal paragraph-6 ">
                            (
                            {{ totalItems }}
                            {{ ( totalItems > 1 ? 'items' : 'item')|trans }}
                            )
                        </span>
                    </div>
                    <div>
                        {{ subTotal }}
                    </div>
                </div>
                <div class="Summary-line">
                    <div>
                        {{ 'Delivery'|trans }}
                    </div>
                    <div>
                        {{ taxed_postage ? taxed_postage : 'Free delivery'|trans }}
                    </div>
                </div>
                {% if this.hasCoupon %}
                    <div class="Summary-line">
                        <div>
                            {{ 'Promo Code'|trans }}
                            {% if promo %}
                                <div class="font-normal paragraph-6">
                                    {{ promo.code }}
                                </div>
                            {% endif %}
                        </div>
                        {% if promo %}
                            <div>
                                {{ include('@components/Molecules/Filters/FilterPill/FilterPill.html.twig',
                {selected: true, customText: promo.reduction, icon: 'price-tag'}) }}
                            </div>
                        {% else %}
                            <div>
                                {{ 'No Promo Code'|trans }}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if not noGiftCard %}
                    <div class="Summary-line">
                        <div>
                            {{ 'Gift Card'|trans }}
                            <div class="font-normal paragraph-6">
                                {{ giftCard.code }}
                            </div>
                        </div>
                        {% if giftCard %}
                            <div>
                                {{ include('@components/Molecules/Filters/FilterPill/FilterPill.html.twig',
                {selected: true, customText: giftCard.reduction, icon: 'gift'}) }}
                            </div>
                        {% else %}
                            <div>
                                {{ 'No Gift Card'|trans }}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if this.hasDiscount %}
                    <div class="Summary-line">
                        <div>
                            {{ 'Discount'|trans }}
                        </div>
                        <div>
                            {{ taxed_discount }}
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="Summary-footer">
                <div class="Summary-total">
                    <div>
                        {% if this.hasTax %}
                            {{ 'Total (including VAT)'|trans }}
                        {% else %}
                            {{ 'Total'|trans }}
                        {% endif %}
                    </div>
                    <div>
                        {{ total }}
                    </div>
                </div>
                {% if this.hasTax %}
                    <div class="italic">
                        {{ 'Taxes of'|trans }}
                        {{ tax }}
                        {{ 'included'|trans }}
                    </div>
                {% endif %}
                {% if cgvLink %}
                    <div class="mt-2">
                        {{ 'By paying for your order, you agree to our'|trans }}
                        <a href='{{ cgvLink }}'>
                            {{ 'terms and conditions'|trans }}
                        </a>
                        .
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
