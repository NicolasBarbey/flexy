<div {{ attributes }}>

    {% if constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutSteps::PAYMENT') == this.step %}
        {{ component('Flexy:Button', {
            text: 'Order'|trans,
            disabled: not this.isValid,
            href:path('checkout_pay')
        }) }}
        {% else %}
        {{ component('Flexy:Button', {
            text: 'Order'|trans,
            disabled: not this.isValid,
            href: this.isValid ? href : null,
        }) }}
    {% endif %}

</div>
