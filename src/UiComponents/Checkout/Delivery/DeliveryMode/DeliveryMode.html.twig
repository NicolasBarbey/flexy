<div {{attributes.defaults({class: 'DeliveryMode DeliveryModule ' ~ (this.checked ? 'selected ' : '') ~ type })}}>

    <label class='DeliveryMode-content'>
		<span class="pr-2">
			{{ component('Flexy:RadioButton', {
				'data-action': 'live#emit',
				'data-live-event-param': constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutEvents::SET_DELIVERY_MODULE_OPTION'),
				'data-live-option-code-param': this.optionCode,
				'data-live-module-id-param': this.moduleId,
				checked : this.checked
			})}}
		</span>

        <span>
			<div class='flex justify-between'>
				<div>
					<span class='DeliveryMode-title'>{{ this.title }}</span>
					{% if this.date %}
                        <span class='DeliveryMode-description'>{{ 'Estimated delivery on'|trans }} {{ this.date }}</span>
                    {% endif %}
				</div>
				{% if icon %}
                    <div class="w-[42px] h-[38px] text-theme-medium">
					{{ ux_icon(icon) }}
				</div>
                {% endif %}
			</div>
			<div class='flex items-center justify-between mt-6'>
				<span class='DeliveryMode-price'>{{ this.price ? this.price|format_currency('EUR', locale: lang_code) : 'Free'|trans }}</span>
				{% include '@components/Molecules/Tag/Tag.html.twig' with { icon: "carbone", customText: "Todo Co2" } %}
			</div>

            {% block content %}{% endblock %}

		</span>
    </label>
    {% block footer %}{% endblock %}
</div>
