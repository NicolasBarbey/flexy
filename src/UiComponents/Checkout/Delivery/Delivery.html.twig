<div {{attributes}}>
    <h1 class='text-black  h4'>{{ 'Choose a delivery method'|trans }}</h1>

    <div class='flex flex-col gap-3.5 my-5'>
        {% if this.deliveryModulesOptions is defined and not empty %}

            {% for option in this.deliveryModulesOptions %}
                {% if option.deliveryMode == enum('Thelia\\Core\\Enum\\DeliveryMode').DELIVERY.value %}
                    {{ component('Flexy:Checkout:Delivery:HomeDelivery', {
                        title: option.title,
                        date: "TODO BACK",
                        price: option.postage,
                        optionCode: option.code,
                        moduleId: option.moduleId,
                        icon: 'reinsurance-homedelivery',
                        type: 'HomeDelivery'
                    }) }}
                {% endif %}
                {% if option.deliveryMode == enum('Thelia\\Core\\Enum\\DeliveryMode').LOCAL_PICKUP.value %}
                    {{ component('Flexy:Checkout:Delivery:StoreDelivery', {
                        title: option.title,
                        date: "TODO BACK",
                        price: option.postage,
                        optionCode: option.code,
                        moduleId: option.moduleId,
                        icon: 'reinsurance-store'
                    }) }}
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="alert alert-warning">
                {{ "No delivery method is available for this order."|trans }}
            </div>
        {% endif %}
    </div>

</div>