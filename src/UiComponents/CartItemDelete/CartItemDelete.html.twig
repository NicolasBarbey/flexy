<div class="CartItemDelete">
    <div class="CartItemDelete-mainContent">
        {{ getImages({
            'source_type': 'product',
            'img_id': imageId,
            'alt': title,
            'filters': 'default',
            'wrapper': 'picture',
            'wrapper_attrs': {
                'class' : 'CartItemDelete-img'
            },
            'img_attrs': {
                'width' : '88',
                'height' : '88'
            },
            'limit':1,
            placeholder: asset('dist/images/placeholder.webp'),
        })|raw }}
        <div class="CartItemDelete-desc">
            <div class="mb-2 paragraph-3">
                {{ title }} {{ 'has been removed from your cart.'|trans }}
            </div>
            {{ component('Flexy:Button', {
                size: "small",
                text: 'Restore'|trans,
                icon_left: "restore",
                'data-action': 'live#action',
                'data-live-action-param': 'restoreCartItem',
                'data-live-pse-id-param': pseId,
                'data-live-product-id-param': productId,
                'data-live-quantity-param': quantity,
            }) }}
        </div>
    </div>
</div>
