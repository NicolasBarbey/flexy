<div {{ attributes.defaults(stimulus_controller('register-validation-code')) }} data-loading="addClass(opacity-50)">

    {% if this.canLogin %}
        {% for text in app.flashes('success') %}
            {% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {
                text,
                variant: 'validated',
                withIcon: true,
                size: "full"
            } %}
        {% endfor %}
       <div class="mt-6 flex justify-center">
           {{ component('Flexy:Button', {
               text: 'Login'|trans,
               href: '/account',
           }) }}
       </div>
        {% else %}
    {{ form_start(form) }}
    {{ form_errors(form) }}
    {% for text in app.flashes('error') %}
        {% set flashError = 1 %}
        {% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {
            text,
            variant: 'error',
            withIcon: true,
            size: "full"
        } %}

    {% endfor %}
    <div class=" justify-center flex gap-4 flex-wrap mt-6"  data-live-ignore>
        {% for i in 1..constant('Thelia\\Model\\Customer::CODE_LENGTH') %}
            <label for="charset_{{ i }}" class="FieldCode{{ app.flashes('error') ? ' FieldCode--error' : '' }}">
                <input id="charset_{{ i }}" type="number"  data-register-validation-code-target="input" data-action="register-validation-code#input"/>
            </label>
        {% endfor %}
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
    <div class="mt-[40px] pt-[40px] border-t border-gray-700 text-center">
        <strong class="block">{{ "Dont't have receive code ?"|trans }}</strong>
        <span>{{ 'resend_code'|trans({'%h': path('customer_send_code', {email})})|raw }}</span>
    </div>
    {% endif %}
</div>
