{% props
    variant = 'light',
    size = 'small',
    withIcon = false,
    text = '',
    button = null,
    icon = '',
%}

{% set snackbar = html_cva(
    base: 'SnackBar transition transform duration-1000 hidden',
    variants: {
        variant: {
            light: 'SnackBar--neutral-light',
            dark: 'SnackBar--neutral-dark',
            error: 'SnackBar--error',
            info: 'SnackBar--informative',
            warning: 'SnackBar--warning',
            success: 'SnackBar--success',
            validated: 'SnackBar--validated',
        },
        size: {
            large: 'SnackBar-large',
            small: 'SnackBar-small',
            full: 'SnackBar-full',
        },
    },
) %}

{% if variant == constant('FlexyBundle\\UiComponents\\SnackBar\\SnackBar::ERROR') %}
    {% set icon = 'error' %}
{% elseif variant == constant('FlexyBundle\\UiComponents\\SnackBar\\SnackBar::WARNING') %}
    {% set icon = 'warning' %}
{% elseif variant == constant('FlexyBundle\\UiComponents\\SnackBar\\SnackBar::INFO') %}
    {% set icon = 'info' %}
{% elseif variant == constant('FlexyBundle\\UiComponents\\SnackBar\\SnackBar::VALIDATED') %}
    {% set icon = 'check' %}
{% endif %}

<div
    class="{{ snackbar.apply({variant, size}, attributes.render('class')) }}"
    data-transition-enter-from="opacity-0 translate-x-6"
    data-transition-enter-to="opacity-100 translate-x-0"
    data-transition-leave-from="opacity-100 translate-x-0"
    data-transition-leave-to="opacity-0 translate-x-6"
    data-notification-delay-value="200000"
    {{ attributes.defaults(stimulus_controller('notification')) }}

>
    <div class="SnackBar-content">
		{% if withIcon and icon %}
			<div class="SnackBar-icon">
				{{ ux_icon(icon) }}
			</div>
		{% endif %}
		<div class="SnackBar-message">
			{{ text|raw }}
		</div>
	</div>


    {% if button %}
        {% block button %}
            <div class="SnackBar-button">
                {{ component('Flexy:Button', {
                    text: 'Close'|trans,
                    size: 'small',
                    color: 'secondary',
                    'data-action': 'notification#hide'
                    })
                }}
            </div>
        {% endblock %}
    {% endif %}

</div>
