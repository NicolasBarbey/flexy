
<{{ type }} {{ attributes.defaults({class: 'radio ' ~ (hasError ? 'error' : '')}) }}>
    <input
        type="radio"
        name="{{ name }}"
        id="{{ id }}"
        value="{{ value }}"
        {% if this.disabled %} disabled {% endif %}
        {% if this.checked %} checked {% endif %}
        {{ attributes.nested('input') }}
    />
    <span class="checkmark"></span>
    <span>{{ label }}</span>
</{{ type }}>
