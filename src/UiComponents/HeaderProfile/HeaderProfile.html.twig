{% set customer = getCurrentCustomer() %}
{% set headerButtonConfig = {
    icon: 'account-logged',
    text: customer.firstname ~ ' ' ~ customer.lastname|first|upper ~ '.',
    color: "theme",
    class: 'HeaderNav-btn profile w-full h-full',
    'data-action': 'drawer#toggle profile#toggle',
} %}

<div class="relative grow h-full flex" {{ stimulus_controller('drawer profile') }}>
    {{ component('Flexy:HeaderButton' , headerButtonConfig) }}
    <div class="MobileDrawer lg:reset-drawer" data-drawer-target="drawer">
        <div class="mobileDrawer-header">
            <strong class="block text-center text-black h3">
                {{ 'hy_customer'|trans({'%firstname%': customer.firstname}) }}
            </strong>
            <button class="mobileDrawer-close" type="button" data-action="drawer#close">
                {{ ux_icon('close') }}
            </button>
        </div>
        <ul class="DropdownProfile" data-profile-target="dropdown">
            {% for item in this.accountItems %}
                <li class="DropdownProfile-item">
                    {{ include('@components/Molecules/UserMenu/UserMenu.html.twig', item) }}
                </li>
            {% endfor %}
            <li class="DropdownProfile-item">
                {{ include('@components/Molecules/UserMenu/UserMenu.html.twig', {
                    text: 'Logout'|trans,
                    href: path('customer_logout'),
                    icon: true,
                }) }}
            </li>
        </ul>
    </div>
</div>
