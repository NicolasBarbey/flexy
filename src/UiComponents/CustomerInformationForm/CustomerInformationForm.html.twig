<div {{ attributes }}>
    {{ form_start(form, {attr: {
        class: "flex flex-col"
    }}) }}
    <div class="flex flex-col gap-6 order-1">
        {{ form_row(form.country)}}
        {% if form.state is defined %}
            {{ form_row(form.state) }}
        {% endif %}
        {{ form_row(form.phone)}}
        {{ form_row(form.cellphone)}}
        {{ form_row(form.newsletter)}}
        {{ form_row(form.accept_privacy_policy)}}
        {{ form_row(form.submit)}}
    </div>
    <div class="flex flex-col gap-6 order-0 mb-6">
        {{ form_rest(form) }}
    </div>
    {{ form_end(form) }}
</div>
