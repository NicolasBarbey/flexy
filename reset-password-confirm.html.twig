{% extends 'base.html.twig' %}

{% block title %}{{ 'Reset your password'|trans }}{% endblock %}

{% block body %}
    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        <h2 class="h2 text-black mb-4">{{ 'Reset your password'|trans }}</h2>

        <twig:Molecules:SnackBar:Base variant="success" text="{{ 'Your password has been reset!'|trans }}" />

        <p class="paragraph-2 text-black mt-6 mb-6">{{ 'You can now log in to your account.'|trans }}</p>

        <twig:Molecules:Button:Base href="{{ path('customer_login') }}" text="{{ 'Log in'|trans }}" />
    </div>
{% endblock %}
