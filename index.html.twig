{% extends 'base.html.twig' %}

{% block breadcrumb_json %}{% endblock %}

{% block body %}
    <twig:Layouts:CrossSelling:Base categoryId="1" title="{{ 'Last seen products'|trans }}" />

    <div class="bg-lighter">
        <twig:Layouts:CrossSelling:Base categoryId="2" title="{{ 'Popular products'|trans }}" />
    </div>
    <div class="bg-lightest">
        <twig:Layouts:CrossSelling:Base categoryId="3" title="{{ 'Promotions'|trans }}" />
    </div>

    <twig:Layouts:ProductCategory:Base title="{{ 'Our product categories'|trans }}" />

    {% set reviews = [4, 2, 3]|map((note) => ({
        author: 'Prénom N.',
        review: '“Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.”',
        note: note,
        date: 'JJ/MM/AAAA',
    })) %}

    <div class="bg-lightest">
        <twig:Layouts:Review:Base
            title="{{ 'Our customers speak about us'|trans }}"
            :reviews="reviews"
            :button="{label: 'See all reviews'|trans, href: '#'}"
        />
    </div>

    <div class="bg-lighter">
        <twig:Layouts:SimilarContent:Base title="{{ 'Our news'|trans }}" :button="{label: 'See all news'|trans, href: '#'}" />
    </div>
{% endblock %}
