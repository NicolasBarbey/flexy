{% extends 'checkout-base.html.twig' %}

{% block title %}
    {{ 'Payment Gateway'|trans }}
{% endblock %}

{% block checkoutContent %}
    <div {{ attributes }}>
        <div class="block mx-auto text-center text-black">
            <strong>{{ 'Payment processing...'|trans }}</strong>
        </div>

        <form id="payment-form" method="post" action="{{ gateway_url }}" target="_top" style="display: none;">
            {% for name, value in payment_form_data %}
                <input type="hidden" name="{{ name }}" value="{{ value }}" />
            {% endfor %}
        </form>

        <script>
            setTimeout(() => {
                document.getElementById('payment-form').submit();
            }, 1000);
        </script>

    </div>
{% endblock %}

