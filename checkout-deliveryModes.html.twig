{% extends 'checkout-base.html.twig' %}

{% block title %}
	{{'Delivery Modes'|trans}}
{% endblock %}


{% block checkoutContent %}
	{{ component('Flexy:Checkout:DeliveryModes') }}
{% endblock %}

{% block checkoutBackButton %}
	{% include "@components/Molecules/Link/Link.html.twig" with {
		iconLeft: 'chevron-left',
		customText: 'Previous Step' | trans,
		href: path('checkout_cart'),
		classes:'gap-2'
	} %}
{% endblock %}

{%- block checkoutSummary -%}
	{%- if not emptyCart -%}
		{{ component('Flexy:Checkout:Summary') }}
	{%- endif -%}
{%- endblock -%}

{%- block checkoutNextButton -%}
	{%- 
		include '@components/Molecules/Button/Button.html.twig' with 
		{
			text: 'Order'|trans, 
			href: path('checkout_delivery'), 
			classes:'md:Button--unfill Button--fill'
		} only
	-%}
{%- endblock -%}
