root = true

# Indent sizes follow what the theme already contains, measured file by file, rather than a
# single blanket value: PHP/Twig/JSON/YAML are on 4, CSS and JS on 2.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,twig,json,yaml,yml,xml,neon}]
indent_size = 4

[*.{css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
