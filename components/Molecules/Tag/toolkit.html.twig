

<div class="grid gap-8">
    <div class="flex flex-col gap-2">
        <h4>base</h4>
        <div class="flex gap-2">
            <twig:Molecules:Tag:Base customText="Code Promo" icon="price-tag"  />
            <twig:Molecules:Tag:Base customText="Code Promo" />
            <twig:Molecules:Tag:Base customText="noBackground" icon="price-tag" noBackground   />
            <twig:Molecules:Tag:Base customText="noBorder" icon="price-tag"  noBorder   />
            <twig:Molecules:Tag:Base customText="noBackground noBorder" icon="price-tag"  noBackground noBorder  />
        </div>

        <twig:Molecules:Tag:Base customText="action" {{...stimulus_action('controller', 'action')}}  />

        <twig:Molecules:Tag:Base customText="0.12 kg CO2" icon="carbone" color="success" />
        <twig:Molecules:Tag:Base customText="Valid" color="validated" />
        <twig:Molecules:Tag:Base customText="Warning" color="warning" />
        <twig:Molecules:Tag:Base customText="Error" color="error" />
    </div>
    <div class="flex flex-col gap-2">
        <h4>Stock</h4>
        <twig:Molecules:Tag:Stock customText="En Stock" color="in" />
        <twig:Molecules:Tag:Stock customText="Stocks faibles" color="low" />
        <twig:Molecules:Tag:Stock customText="Epuisé" color="out" />
    </div>
    <div class="flex flex-col gap-2">
        <h4>Order</h4>
        <twig:Molecules:Tag:Order customText="Commande non payée" status="not_paid" />
        <twig:Molecules:Tag:Order customText="Commande payée" status="paid" />
        <twig:Molecules:Tag:Order customText="Commande en préparation" status="processing" />
        <twig:Molecules:Tag:Order customText="Commande expédiée" status="sent" />
        <twig:Molecules:Tag:Order customText="Commande annulée" status="canceled" />
        <twig:Molecules:Tag:Order customText="Commande remboursée" status="refunded" />
    </div>

</div>
