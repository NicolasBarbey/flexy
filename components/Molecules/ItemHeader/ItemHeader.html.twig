{% set href = href|default('') %}
{% set classes = classes|default('') %}
{% set customText = customText|default('') %}
{% set sub = sub|default(null) %}
{% set node = node|default(null) %}
{% set subCategories = node ? (node.children|default([])) : [] %}
{% set isActive = false %}

<li class="ItemHeader" {{ stimulus_controller('item-header') }}>
	{% if subCategories|length %}
		<button type="button" class="ItemHeader-link {{ classes }} {% if isActive %}is-active{% endif %}" data-action="item-header#toggle" data-item-header-target="toggler">
			{{ customText }}
		</button>
		<button type="button" class="ItemHeader-back" data-action="header#displaySubMenu" data-header-item-param="{{ sub }}">
			{{ ux_icon('arrow-right') }}
		</button>
		<ul class="Submenu" data-menu-sub="{{ sub }}" data-menu-previous="0" data-header-target="sub">
			<li class="ItemHeader-all">
				{{ component('Flexy:Button', {
                    text: 'every_cat'|trans({'%cat': customText}),
                    href,
                    class: 'w-full lg:w-auto mt-4 lg:mt-auto'
                }) }}
			</li>
			{% for category in subCategories %}
				<li class="Submenu-item">
					{% set sub2Categories = category.children|default([]) %}
					<a href="{{ category.publicUrl }}" class="Submenu-link">
						{{ category.i18ns.title }}
					</a>
					{% if sub2Categories %}
						<button type="button" class="ItemHeader-back" data-action="header#displaySubMenu" data-header-item-param="{{ sub }}_5">
							{{ ux_icon('arrow-right') }}
						</button>
						<ul class="Submenu-sub" data-menu-sub="{{ sub }}_5" data-menu-previous="{{ sub }}" data-header-target="sub">
							{% for subCat in sub2Categories %}
								<li class="Submenu-subItem">
									<a href="{{ subCat.publicUrl }}">
										{{ subCat.i18ns.title }}
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	{% else %}
		<a href='{{ href }}' class="ItemHeader-link {{ classes }}" data-item-header-target="toggler">
			{{ customText }}
		</a>
	{% endif %}
</li>
