{% set classes = 'button--round' %}
{% if variant != 'primary' %}
    {% set classes = classes ~ ' button--' ~ variant %}
{% endif %}

<div>
    <div class="h4-desktop mb-5">
        Large
    </div>
    <div class="flex gap-4">
        {{ include('./Button.html.twig',
      {classes: 'button--large',
        round: true,
        variant: variant,
        icon_left: icon}) }}
        {{ include('./Button.html.twig',
      {disabled: true, round: true, classes: 'button--large',
        icon_left: icon}) }}
    </div>
</div>

<div class="mt-5">
    <div class="h4-desktop mb-5">
        Small
    </div>
    <div class="flex gap-4">
        {{ include('./Button.html.twig',
      {classes: 'button--small', round: true,
        icon_left: icon}) }}
        {{ include('./Button.html.twig',
      {disabled: true, classes: 'button--small', round: true,
        icon_left: icon}) }}
    </div>
</div>
