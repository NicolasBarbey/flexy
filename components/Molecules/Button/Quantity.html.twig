{% props disabled = false, name = null, value = null, color = null %}

{% set buttonQuantity = html_cva(
    base: 'ButtonQuantity ',
) %}

{% set buttonInputQuantity = html_cva(
    base: 'ButtonQuantity__input ',
    default_variant: {
        color: 'base',
    },
    variants: {
        color: {
            base: 'button-style',
            secondary: 'button-style--secondary',
        },
    },
) %}

<div role="button" class="{{ buttonQuantity.apply({color}, attributes.render('class')) }} "  {{ attributes.defaults(stimulus_controller('Molecules--Button--quantity')).without('class', 'button:color') }} >
    <twig:Flexy:Molecules:Button:Base {{...attributes.nested('button')}} disabled="{{ disabled }}" {{...stimulus_action('Molecules--Button--quantity', 'decrement')}}>-</twig:Flexy:Molecules:Button:Base>
    <input
        type="number"
        class="{{ buttonInputQuantity.apply({color}, attributes.nested('input').render('class')) }} "
        {% if disabled %} disabled {% endif %}
        {{attributes.nested('input')}}
        {{stimulus_target('Molecules--Button--quantity', 'input')}}
    >
    <twig:Flexy:Molecules:Button:Base {{...attributes.nested('button')}} disabled="{{ disabled }}" {{...stimulus_action('Molecules--Button--quantity', 'increment')}}>+</twig:Flexy:Molecules:Button:Base>
</div>
