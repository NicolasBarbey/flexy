{% set iconLeft = icon_left == 'none' ? '' : icon_left %}
{% set iconRight = icon_right == 'none' ? '' : icon_right %}
<div>
    <div class="h4-desktop mb-5">
        Large
    </div>
    <div class="flex gap-4">
        {{ include('./Button.html.twig',
      {disabled: false, classes: 'button--large', variant: variant, fill: fill, rectangle: rectangle, text: customText,
        icon_left: iconLeft,
        icon_right: iconRight}) }}
        {{ include('./Button.html.twig',
      {disabled: true, classes: 'button--large', variant: variant, fill: fill, rectangle: rectangle, text: customText,
        icon_left: iconLeft,
        icon_right: iconRight}) }}
    </div>
</div>

