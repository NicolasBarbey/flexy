{% set classes = classes|default('') %}
{% set value = value|default('') %}
{% set disabled = disabled|default(false) %}
{% set icon = icon|default(null) %}
{% set text = text|default('') %}
{% set quantity = quantity|default(1) %}
{% set btnLiveAction = btnLiveAction|default(null) %}
{% set name = name|default('') %}
{% set plusDisabled = plusDisabled|default(false) %}
{% set minusDisabled = minusDisabled|default(false) %}
{% set plusHidden = plusHidden|default(false) %}
{% set min = min|default(null) %}
{% set max = max|default(null) %}

<div class="Button-quantityButton">
    {{ include('@components/Molecules/Button/Quantity.html.twig', {
        disabled: disabled,
        value: value,
        classes: classes,
        name: name,
        btnLiveAction: btnLiveAction,
        plusDisabled: plusDisabled,
        minusDisabled: minusDisabled,
        plusHidden: plusHidden,
        min: min,
        max: max,
        })
    }}

    {{ component('Flexy:Button', {
      disabled: disabled,
      text: text,
      large: true,
      icon_left: icon,
      fill: true,
    }) }}
</div>
