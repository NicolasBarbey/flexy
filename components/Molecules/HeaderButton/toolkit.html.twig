<div class="grid gap-8">
    <div class="grid gap-4">
        <h4>Couleurs</h4>
        <div class="flex h-20 bg-grey-lighter">
            <twig:Molecules:HeaderButton:Base icon="heart-fill" text="Wishlist" color="light" />
            <twig:Molecules:HeaderButton:Base icon="account" text="Connexion" color="theme" />
            <twig:Molecules:HeaderButton:Base icon="cart" text="Panier" color="dark" />
        </div>
    </div>

    <div class="grid gap-4">
        <h4>Avec sous-texte</h4>
        <div class="flex h-20 bg-grey-lighter">
            <twig:Molecules:HeaderButton:Base icon="cart" text="Panier" subText="(2 000,00 €)" color="dark" />
        </div>
    </div>

    <div class="grid gap-4">
        <h4>Small (texte masqué à partir de md)</h4>
        <div class="flex h-20 bg-grey-lighter">
            <twig:Molecules:HeaderButton:Base icon="menu" text="Menu" color="light" small="true" />
        </div>
    </div>

    <div class="grid gap-4">
        <h4>Lien (href)</h4>
        <div class="flex h-20 bg-grey-lighter">
            <twig:Molecules:HeaderButton:Base href="#" icon="account" text="Mon compte" color="theme" />
        </div>
    </div>
</div>
