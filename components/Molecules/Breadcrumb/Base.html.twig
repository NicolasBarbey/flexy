
{% props items = [] %}

{% set breadcrumb = html_cva(
    base: 'Breadcrumb ',

    variants: {
    },
) %}

{% if items is not empty %}
    <aside class="{{ breadcrumb.apply({}, attributes.render('class')) }} " {{ attributes.without('class') }} aria-label="{{ 'Breadcrumb'|trans }} ">
        <nav>
            <ol class="Breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li class="Breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/" class="Breadcrumb-link" itemprop="item">
                        <span itemprop="name">
                            {{ 'Home'|trans }}
                        </span>
                    </a>
                    <meta itemprop="position" content="1"/>
                </li>
                {% for item in items %}
                    <li class="Breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        {% if loop.index != loop.last %}
                            <a class="Breadcrumb-link" href="{{ item.url }}" itemprop="item">
                                <span itemprop="name" class="Breadcrumb-link" itemprop="item">
                                    {{ item.title }}
                                </span>
                            </a>
                            <meta itemprop="position" content="{{ loop.index + 1 }}"/>
                        {% else %}
                            <span class="no-underline Breadcrumb-link" itemprop="name" aria-current="page">
                                {{ item.title }}
                            </span>
                            <meta itemprop="position" content="{{ loop.index + 1 }}"/>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </nav>
    </aside>
{% endif %}
