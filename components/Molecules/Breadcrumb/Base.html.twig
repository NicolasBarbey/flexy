{% props items = [] %}

{# An untranslated entity yields a title-less item: unrenderable, and invalid as structured data #}
{% set items = items|filter(item => item.title is not empty) %}

{% if items is not empty %}
    {% set home = {title: 'Home'|trans, url: '/'} %}
    {% set parent = items|slice(0, items|length - 1)|last|default(home) %}

    <div class="{{ ('Breadcrumb ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
        <nav class="sr-only" aria-label="{{ 'Breadcrumb'|trans }}">
            <ol itemscope itemtype="https://schema.org/BreadcrumbList">
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/" itemprop="item">
                        <span itemprop="name">{{ 'Home'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="1"/>
                </li>
                {% for item in items %}
                    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        {% if loop.index != loop.last %}
                            <a href="{{ item.url }}" itemprop="item">
                                <span itemprop="name">{{ item.title }}</span>
                            </a>
                        {% else %}
                            <span itemprop="name" aria-current="page">{{ item.title }}</span>
                        {% endif %}
                        <meta itemprop="position" content="{{ loop.index + 1 }}"/>
                    </li>
                {% endfor %}
            </ol>
        </nav>

        <twig:Molecules:Button:Base href="{{ parent.url }}" text="{{ parent.title }}" color="minimal" icon_left="chevron-left" />
    </div>
{% endif %}
