{% set classes = classes|default('') %}
{% set items = items|default([]) %}

{% if items is not empty %}
	<aside class="Breadcrumb {{ classes }}" aria-label="Fil d'Ariane">
		<nav>
			<ol class="Breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="Breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a href="/" class="Breadcrumb-link" itemprop="item">
						<span itemprop="name">{{'Home'|trans}}</span>
					</a>
					<meta itemprop="position" content="1"/>
				</li>
				{% for item in items %}
					<li class="Breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
						<span class="inline-block text-2xs">/</span>
						{% if item.href %}
							<a class="Breadcrumb-link" href="{{ item.href }}" itemprop="item">
								<span itemprop="name">{{ item.label }}</span>
							</a>
							<meta itemprop="position" content="{{ loop.index + 1 }}"/>
						{% else %}
							<span class="Breadcrumb-link" itemprop="name" aria-current="page">
								{{ item.label }}
							</span>
							<meta itemprop="position" content="{{ loop.index + 1 }}"/>
						{% endif %}
					</li>
				{% endfor %}
			</ol>
		</nav>
	</aside>
{% endif %}
