<div class="LangSelect" {{ stimulus_controller('lang-select') }}>
	<button type="button" class="LangSelect-current" data-action="lang-select#toggle" data-lang-select-target="toggler">
		{{ux_icon('flags:'~currentLang.code, {class: 'LangSelect-flag'})}}
		{{currentLang.code}}
		{{ux_icon('chevron-small-down', {class: 'w-6 h-6'})}}
	</button>
	{% if langs|length %}
		<ul class="LangSelect-list">
			{% for lang in langs %}
				<li>
					<a href="{{attr('config','url_site')~'?'~{'lang': lang.locale}|url_encode }}" class="LangSelect-lang {% if currentLang.code == lang.code %}active{% endif %}">
						{{ux_icon('flags:'~lang.code, {class: 'LangSelect-flag'})}}
						<span>{{lang.title}}</span>
						{% if currentLang.code == lang.code %}
							{{ux_icon('checkmark', {class: 'LangSelect-check'})}}
						{% endif %}
					</a>
				</li>
			{% endfor %}
		</ul>
	{% endif %}

</div>
