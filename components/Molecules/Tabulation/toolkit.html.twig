{% macro row(size) %}
    <div class="flex flex-wrap gap-4 items-center">
        <twig:Flexy:Molecules:Tabulation:Base customText="Tab" size="{{ size }}" />
        <twig:Flexy:Molecules:Tabulation:Base customText="With left icon" iconLeft="chevron-left" size="{{ size }}" />
        <twig:Flexy:Molecules:Tabulation:Base customText="With right icon" iconRight="chevron-right" size="{{ size }}" />
        <twig:Flexy:Molecules:Tabulation:Base customText="Both icons" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" />
        <twig:Flexy:Molecules:Tabulation:Base customText="Disabled" size="{{ size }}" disabled />
        <twig:Flexy:Molecules:Tabulation:Base customText="Disabled icon" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" disabled />
    </div>
{% endmacro %}

<div class="grid gap-8">
    <div class="grid gap-2">
        <h4>Default</h4>
        {{ _self.row(null) }}
    </div>
    <div class="grid gap-2">
        <h4>Large</h4>
        {{ _self.row('large') }}
    </div>
    <div class="grid gap-2">
        <h4>Small</h4>
        {{ _self.row('small') }}
    </div>
</div>
