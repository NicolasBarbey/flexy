<div class="PasswordControls" data-password-target="control">
	{{'Your Message must contain'|trans}}
	:
	<ul>
		<li data-password-target="size">{{'at least 12 characters'|trans}}</li>
		<li data-password-target="uppercase">{{'at least 1 capital letter'|trans}}</li>
		<li data-password-target="lowercase">{{'at least 1 low-case letter'|trans}}</li>
		<li data-password-target="number">{{'at least 1 digit'|trans}}</li>
		<li data-password-target="special">{{'at least 1 special character'|trans}}</li>
	</ul>
</div>
