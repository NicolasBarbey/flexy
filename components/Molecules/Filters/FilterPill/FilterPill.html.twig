{% use '@formTwig/flexy_form_theme.html.twig' %}

{% set icon = icon|default(null) %}
{% set closeButton = closeButton|default(null) %}
{% set iconColor = iconColor|default(null) %}
{% set type = type|default('checkbox') %}
{% set inDrawer = inDrawer|default(false) %}
{% set classes = classes|default(null) %}

{% if icon %}
    {% set classes = classes ~ ' filterPill--withIcon' %}
{% endif %}
{% if inDrawer %}
    {% set classes = classes ~ ' filterPill--drawer' %}
{% endif %}
{% if color %}
    {% set icon = 'circle' %}
    {% set iconColor = color %}
{% endif %}

{% set attr = choice.attr|merge({class : choice.attr.class~ 'hidden'}) %}

<label class="filterPill{{ classes }}" {% if inDrawer %} data-action="click->filter-choice#updateLabel click->drawer#close" data-filter-choice-label-param="{{choice.label}}" {% endif %}>
    <input type='{{ type }}' class="hidden" {{ block('widget_attributes') }} value="{{ choice.value }}" {% if choice.value in value  %}checked{% endif %}/>
    {% if icon %}
        <span class="filterPill-icon" {% if iconColor %} style="color:{{ iconColor }}" {% endif %}>{{ ux_icon(icon) }}</span>
    {% endif %}
    {{ choice.label }}
    {% if closeButton %}
        <span class='filterPill-iconClose'>{{ ux_icon("close") }}</span>
    {% endif %}
</label>
