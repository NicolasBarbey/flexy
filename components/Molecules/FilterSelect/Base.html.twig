{# @prop id string Radio group name, also used to build each option's input id #}
{# @prop options array List of {value, label} options, label is rendered raw #}
{# @prop placeholder string|null Optional first "no selection" option, selected by default when set #}
{# @prop rounded bool Pill-shaped trigger variant #}
{% props id, options = [], placeholder = null, rounded = false %}

{% set filterSelect = html_cva(
    base: 'FilterSelect',
    variants: {
        rounded: {
            true: 'FilterSelect--rounded',
        },
    }
) %}

{# Single source of truth for both controller identifiers: reused below in stimulus_action()/
   stimulus_controller() calls AND in the hand-written data-action attribute (see comment
   there), so a rename only requires editing these two lines. #}
{% set mobileDrawerController = 'Molecules--MobileDrawer--base' %}
{% set filterSelectController = 'Molecules--FilterSelect--base' %}

<div
    class="{{ attributes.render('class') }}"
    {{ attributes.defaults({
        ...stimulus_controller(mobileDrawerController)|stimulus_controller(filterSelectController),
    }).without('class') }}
>
    <div class="{{ filterSelect.apply({rounded}) }}">
        <div
            class="FilterSelect-current"
            tabindex="0"
            {{ stimulus_action(mobileDrawerController, 'toggle', 'click')|stimulus_action(mobileDrawerController, 'toggle', 'keydown.enter')|stimulus_action(mobileDrawerController, 'toggle', 'keydown.space') }}
        >
            {% if placeholder %}
                <div class="FilterSelect-value">
                    <input class="FilterSelect-input" type="radio" value="" name="{{ id }}" checked />
                    <p class="FilterSelect-text">{{ placeholder }}</p>
                </div>
            {% endif %}
            {% for option in options %}
                <div class="FilterSelect-value">
                    {#
                        data-action written by hand instead of via stimulus_action(): a real click on this
                        input only ever happens as a synthetic click forwarded by its <label for="...">,
                        which then bubbles up into .FilterSelect-current's own toggle action and would
                        reopen what we just closed. The :stop action option (event.stopPropagation()) cuts
                        that bubbling at the source. stimulus_action() (vendor/symfony/stimulus-bundle) has
                        no parameter for action options (:stop/:prevent/:self) — appending one requires the
                        literal attribute; it reuses mobileDrawerController above so a rename still only
                        touches one line.
                    #}
                    <input
                        class="FilterSelect-input"
                        type="radio"
                        id="{{ id }}-{{ option.value }}"
                        value="{{ option.value }}"
                        name="{{ id }}"
                        {% if not placeholder and loop.index == 1 %}checked{% endif %}
                        data-action="click->{{ mobileDrawerController }}#close:stop"
                    />
                    <p class="FilterSelect-text">{{ option.label|raw }}</p>
                </div>
            {% endfor %}
            <span class="FilterSelect-icon">{{ ux_icon('chevron-down') }}</span>
        </div>

        <ul class="FilterSelect-list">
            {% for option in options %}
                <li class="FilterSelect-listItem">
                    <label
                        tabindex="0"
                        class="FilterSelect-option"
                        for="{{ id }}-{{ option.value }}"
                        {{ stimulus_action(filterSelectController, 'activate', 'keydown.enter')|stimulus_action(filterSelectController, 'activate', 'keydown.space') }}
                    >
                        {{ option.label|raw }}
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>

    {# Same options as above, duplicated for the mobile drawer's own list — both sets of labels
       point at the same underlying radio inputs via `for`, only one visual list is ever shown
       at a time (MobileDrawer hides itself from md upward, this one is hidden below md). #}
    <twig:Molecules:MobileDrawer:Base class="md:hidden">
        {% if placeholder %}
            <p class="FilterSelect-mobileTitle h4">{{ placeholder }}</p>
        {% endif %}
        <ul class="FilterSelect-mobileList">
            {% for option in options %}
                <li class="FilterSelect-listItem">
                    <label
                        tabindex="0"
                        class="FilterSelect-option"
                        for="{{ id }}-{{ option.value }}"
                        {{ stimulus_action(filterSelectController, 'activate', 'keydown.enter')|stimulus_action(filterSelectController, 'activate', 'keydown.space') }}
                    >
                        {{ option.label|raw }}
                    </label>
                </li>
            {% endfor %}
        </ul>
    </twig:Molecules:MobileDrawer:Base>
</div>
