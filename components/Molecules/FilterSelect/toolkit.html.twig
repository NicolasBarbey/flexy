{% set demoOptions = [
    {value: 'newest', label: 'Newest'},
    {value: 'price-asc', label: 'Price: low to high'},
    {value: 'price-desc', label: 'Price: high to low'},
] %}

<div class="grid gap-12">

    <div class="grid gap-4">
        <h4>Base (desktop dropdown ≥ md, drawer below md)</h4>
        <div class="max-w-xs">
            <twig:Molecules:FilterSelect:Base id="toolkit-filter-select-base" :options="demoOptions" />
        </div>
    </div>

    <div class="grid gap-4">
        <h4>placeholder</h4>
        <div class="max-w-xs">
            <twig:Molecules:FilterSelect:Base id="toolkit-filter-select-placeholder" placeholder="Sort by" :options="demoOptions" />
        </div>
    </div>

    <div class="grid gap-4">
        <h4>rounded</h4>
        <div class="max-w-xs">
            <twig:Molecules:FilterSelect:Base id="toolkit-filter-select-rounded" rounded :options="demoOptions" />
        </div>
    </div>

</div>
