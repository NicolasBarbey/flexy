{% macro row(size) %}
    <div class="flex flex-wrap gap-6 items-center">
        <twig:Flexy:Molecules:Link:Base href="#" customText="Link" size="{{ size }}" />
        <twig:Flexy:Molecules:Link:Base href="#" customText="With left icon" iconLeft="chevron-left" size="{{ size }}" />
        <twig:Flexy:Molecules:Link:Base href="#" customText="With right icon" iconRight="chevron-right" size="{{ size }}" />
        <twig:Flexy:Molecules:Link:Base href="#" customText="Both icons" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" />
        <twig:Flexy:Molecules:Link:Base href="#" customText="Disabled" size="{{ size }}" disabled />
        <twig:Flexy:Molecules:Link:Base href="#" customText="Disabled icon" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" disabled />
        <twig:Flexy:Molecules:Link:Base href="https://example.com" customText="External" target="_blank" size="{{ size }}" />
    </div>
{% endmacro %}

<div class="grid gap-8">
    <div class="grid gap-2">
        <h4>Large (default)</h4>
        {{ _self.row(null) }}
    </div>
    <div class="grid gap-2">
        <h4>Medium</h4>
        {{ _self.row('medium') }}
    </div>
    <div class="grid gap-2">
        <h4>Small</h4>
        {{ _self.row('small') }}
    </div>
</div>
