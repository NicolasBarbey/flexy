{% props label = null, error = false, size = null, choices = [], disabled = false, help = null, value = null %}

{% set select = html_cva(
    base: 'Select',
    variants: {
        error: {
            false: null,
            true: 'Select--error',
            success: 'Select--success',
        },
        size: {
            small: 'Select--small',
            medium: null,
            large: null
        },
        disabled: {
            false: null,
            true: 'Select--disabled',
        }
    },
) %}



<div class="{{ select.apply({size, disabled, error: error ? true : false}, attributes.render('class')) }} " {{attributes.without('class')}}>

    <div class="Select__header">
        <label class="Select__label">{{ label }}</label>
        {% if help is not empty %}
        <span class="Select__help">
                {{ ux_icon('help') }}
        </span>
        {% endif %}
    </div>

    <select {{attributes.nested('select').defaults({ class: 'Select__input' }).without('disabled') }} {% if disabled %}disabled{% endif %}>
        {% for choice in choices %}
            <option value="{{ choice.value }}" {% if value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
        {% endfor %}
    </select>


    {% if error is not empty and  error is not same as(true) %}
        <p class="Select__error">{{ error }}</p>
    {% endif %}
</div>
