{% set choices = [
    { value: '', label: 'placeholder' },
    { value: 'option1', label: 'Option 1' },
    { value: 'option2', label: 'Option 2' },
    { value: 'option3', label: 'Option 3' }
] %}
<div class="grid grid-cols-2 gap-8">
    <div class="flex flex-col gap-4">
        <twig:Fields:Select:Base label="Label" choices="{{ choices }}"  />
        <twig:Fields:Select:Base label="Label" value="option2" choices="{{ choices }}"  />
        <twig:Fields:Select:Base label="Label" choices="{{ choices }}" help="This is a help text" />
        <twig:Fields:Select:Base label="error" error choices="{{ choices }}" help="This is a help text" />
        <twig:Fields:Select:Base label="error details" error="oups" choices="{{ choices }}" help="This is a help text" />
        <twig:Fields:Select:Base label="Disabled" disabled choices="{{ choices }}" help="This is a help text" />
    </div>

    <div class="flex flex-col gap-4 ">
        <twig:Fields:Select:Base label="Label" choices="{{ choices }}" size="small" />
        <twig:Fields:Select:Base label="Label" value="option2" choices="{{ choices }}" size="small" />
        <twig:Fields:Select:Base label="Label" choices="{{ choices }}" size="small" help="This is a help text" />
        <twig:Fields:Select:Base label="error" error choices="{{ choices }}" size="small" help="This is a help text" />
        <twig:Fields:Select:Base label="error details" error="oups" choices="{{ choices }}" size="small" help="This is a help text" />
        <twig:Fields:Select:Base label="Disabled" disabled choices="{{ choices }}" size="small" help="This is a help text" />
    </div>

</div>
