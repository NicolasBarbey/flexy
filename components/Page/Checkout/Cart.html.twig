<div>


	{% if totalItems  %}
		<div class='Checkout-main-header'>
			{{totalItems}}
			{{ totalItems <= 1 ? 'article'|trans : 'articles'|trans }}
		</div>

	{% else %}
		{% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {text: 'Your cart is curently empty'|trans, variant: 'warning', withIcon:true, size: "full"} %}
		{% include "@components/Molecules/Button/Button.html.twig" with {href:app.request.headers.get('referer'), text: "Back to the store"|trans, variant: "large", classes: "mt-4" } %}
	{% endif %}


	<div class='flex flex-col gap-4'>
		{% for item in items %}
			{{ component('Flexy:Organisms:CartItem', {cartItemId: item.id}) }}
		{% endfor %}
	</div>
</div>
