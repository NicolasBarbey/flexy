<div class="PseSelector">
	{{ form_start(form, {attr: {
    class: 'mt-[30px] flex flex-col gap-[30px]',
    'data-action': 'live#action:prevent',
    'data-live-action-param': 'save',
  }},
	    ) }}
	{% set outOfStock = this.isStockManaged() and currentPse.quantity == 0 %}
	<div class="flex items-center justify-between">
		<div class="flex items-center gap-2">
			{{ include('@components/Molecules/Score/Score.html.twig', {score: 3}) }}
			<span class="indication text-grey">
				12
				{{ 'reviews'|trans }}
			</span>
		</div>
		{{ include('@components/Molecules/OrderTag/OrderTag.html.twig', {customText: not outOfStock ? 'In stock'|trans : 'Out of stock'|trans, variant: not outOfStock ? 'success' : 'error', type: 'minimal'}) }}
	</div>
	{% if outOfStock %}
		{{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'This product combination is currently out of stock.'|trans, variant: 'warning', withIcon: true, size: 'full'}) }}
	{% endif %}
	<input type="hidden" name="{{ field_name(form.product) }}" value="{{ field_value(form.product) }}">
	<input type="hidden" name="{{ field_name(form.product_sale_elements_id) }}" value="{{ field_value(form.product_sale_elements_id) }}">
	<input type="hidden" name="{{ field_name(form.append) }}" value="{{ field_value(form.append) }}">
	<input type="hidden" name="{{ field_name(form.newness) }}" value="{{ field_value(form.newness) }}">

	{% if productAttrs|length %}
		<fieldset>
			<ul class="Fieldset-group">
				{% for attr in productAttrs %}
					<li>
						<div class="FilterChoice filterChoice--drawer" data-controller="drawer filter-choice">
							<div class="filterChoice-label" data-action="click->drawer#toggle" data-select-label="{{ attr.values|find(val => val.id == currentPse.combination[attr.id]).label }}" data-filter-choice-target="label">
								{{ attr.label }}
							</div>
							<div class="MobileDrawer sm:reset-drawer" data-drawer-target="drawer">
								<div class="mobileDrawer-header lg:hidden">
									<button class="mobileDrawer-close" type="button" data-action="drawer#close">
										{{ ux_icon('close') }}
									</button>
								</div>
								<ul class="filterChoice-list">
									{% for value in attr.values %}
										{# {% set available = this.isAvailableAttrValue({(attr.id): value.id}) %} #}
										{% set available = true %}
										<li>
											<button type="button" class="filterPill filterPill--drawer {{ currentCombination[attr.id] == value.id ? 'active' : '' }}" data-action="filter-choice#updateLabel drawer#close live#action" data-live-action-param="updateCurrentCombination" data-live-attr-param="{{ attr.id }}" data-live-value-param="{{ value.id }}" data-filter-choice-label-param="{{ value.label }}" {% if not available %} disabled {% endif %}>
                                                {% if value.color is defined %}
                                                    <span class="filterPill-icon"  style="color:{{ value.color }}">{{ ux_icon('circle') }}</span>
                                                {% endif %}
                                                {{ value.label }}
											</button>
										</li>
									{% endfor %}
								</ul>
							</div>
						</div>
					</li>
				{% endfor %}
			</ul>
		</fieldset>
	{% endif %}

	{% if noAvailablePse %}
		{{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'This product combination is not available'|trans, variant: 'warning', withIcon: true, size: 'full'}) }}
		<input type="hidden" name="{{ field_name(form.quantity) }}" value="{{ field_value(form.quantity) }}">
	{% else %}
		{% if not outOfStock %}
			<div class="flex items-center gap-4">
				{% set mainPrice = currentPse.isPromo ? currentPse.promoPrice : currentPse.price %}
				<strong class="text-black h4">
					{{ mainPrice|format_currency('EUR', locale: lang_code) }}
				</strong>
				{% if currentPse.isPromo %}
					<span class="line-through paragraph-4">
						{{ currentPse.price|format_currency('EUR', locale: lang_code) }}
					</span>
				{% endif %}
			</div>

			{% if this.isMaxQuantityReached() %}
				{{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {
						text: 'You already have the maximum available quantity of this product in your cart'|trans,
						variant: 'warning',
						withIcon: true,
						size: 'full'
				}) }}
				<input type="hidden" name="{{ field_name(form.quantity) }}" value="{{ field_value(form.quantity) }}">
			{% else %}
				<div data-controller="quantity">
					{{ include('@components/Molecules/Button/QuantityButton.html.twig', {
                        value: field_value(form.quantity),
                        classes: 'button--large',
                        text: 'Add to cart'|trans,
                        icon: 'cart',
                        fill: true,
                        inLiveComp: true,
                        btnLiveAction: 'getQuantity',
                        name: field_name(form.quantity),
                        plusHidden: this.getRemainingStock() <= (0 + field_value(form.quantity)),
                        minusDisabled: (0 + field_value(form.quantity)) <= 1,
                        min: 1,
                        max: this.isStockManaged() ? this.getRemainingStock() : null
                        },
                    ) }}
				</div>
			{% endif %}
		{% else %}
			<input type="hidden" name="{{ field_name(form.quantity) }}" value="{{ field_value(form.quantity) }}">
		{% endif %}
	{% endif %}

	{{ form_rest(form) }}
	{{ form_errors(form) }}
	{{ form_end(form) }}
</div>
