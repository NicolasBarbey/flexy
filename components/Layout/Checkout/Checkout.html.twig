<div class='grid grid-cols-12' {{ attributes }}>

  <div class='md:col-span-7 col-span-12 Checkout-main'>

    <div class='Checkout-main-container'>
      {% if page == "cart" %}
        {% include '@components/Page/Checkout/Cart.html.twig' with {items: this.cart.items, totalItems:summary.item_count} %}
      {% elseif page == "delivery" %}
        {% include '@components/Page/Checkout/Delivery.html.twig' %}
      {% endif %}
    </div>
  </div>


  <div class='Checkout-sidebar md:col-span-5 col-span-12'>
    <div class='Checkout-sidebar-container'>
      <h2 class='h3 text-black'>{{ 'Summary'|trans }}</h2>
      {% include '@components/Organisms/SummaryCard/SummaryCard.html.twig' with {
        totalItems: summary.item_count,
        subTotal: summary.total_price_without_discount|format_currency('EUR', locale: 'fr'),
        total: summary.total_taxed_price|format_currency('EUR', locale: 'fr'),
        tax: summary.total_tax_amount|format_currency('EUR', locale: 'fr'),
      } %}

      {% include '@components/Layout/Checkout/NextButton.html.twig' with {page: page} %}

    </div>
  </div>

  <div>

  </div>
  {{ component('Flexy:Organisms:CartItemDelete') }}
</div>
{% if page == "cart" %}
  {# {% set recentlyViews = resources('/api/recently_viewed', {itemsPerPage:3}) %} #}
  <div class="bg-theme-lighter">
    {% include '@components/Layout/CrossSelling/CrossSelling.html.twig' with {products: recentlyViews, title: 'Consultés récemment'} %}
  </div>
{% endif %}
