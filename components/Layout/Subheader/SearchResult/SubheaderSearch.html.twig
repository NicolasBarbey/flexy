{% set title = title|default('') %}
{% set nbProducts = nbProducts|default(0) %}

<div class="Subheader Subheader--search">
    <div class="max-w-[600px] w-full flex flex-col mx-auto">
        <h1 class="Subheader-title Subheader-title--search">
            {{ title }}
        </h1>
        <div>
        </div>
        <div class="Subheader-info">
            <div>
                {{ nbProducts }}
                {{ 'product(s)'|trans }}
            </div>
            {{ component('Flexy:Button',{
                color: "secondary",
                text: 'Filter & Sort'|trans,
                icon_left: 'filter'
            }) }}
        </div>
    </div>
</div>
