{% set product_image_params = {
       'source_type': 'product',
            'source_id': productId,
            'filters': 'default',
            'img_attrs': {
                'loading': 'lazy'
            },
            'placeholder': asset('dist/images/placeholder2.webp')
 } %} 
   {% set productImages = getImagesData(product_image_params) %}

<div class="ProductGallery">
	<ul class="ProductGallery-list">
		{% for image in productImages %}
			<li class="ProductGallery-item cursor-pointer{% if loop.index== 1 %} is-active{% endif %}">
				<img class="ProductGallery-thumbnail" data-image-id="{{ image.data.id }}" src="{{image.sources[0].url}}" loading="lazy"/>
			</li>
		{% endfor %}
	</ul>
	<div class="ProductGallery-main">
		<section id="ProductGallery" class="splide" aria-label="{{"Product's visuals"|trans}}" data-count={{productImages|length}}>
			<div class="splide__track">
				<ul class="splide__list">
					{% for image in productImages %}
						<li class="splide__slide">
							<img  src="{{image.sources[0].url}}" class="w-full" loading="lazy"/>
						</li>
					{% endfor %}
				</ul>
			</div>
			{% if productImages|length > 1 %}
				<div class="splide__arrows">
					<button class="splide__arrow splide__arrow--prev">
						{{ ux_icon('arrow-left') }}
					</button>
					<button class="splide__arrow splide__arrow--next">
						{{ ux_icon('arrow-right') }}
					</button>
				</div>
			{% endif %}

		</section>
	</div>
</div>
