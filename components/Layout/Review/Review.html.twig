{% set title = title|default('') %}
{% set reviews = reviews|default([]) %}
{% set button = button|default({label: '', href: ''}) %}

<div class="px-6 py-20 mx-auto md:px-12 md:pr-0 lg:px-0 lg:container">
    <div class="pb-6 text-black h2">
        {{ title }}
    </div>
    <div class="Reviews" {{ stimulus_controller('simple-slider') }}>
        {% for review in reviews %}
            {{ include('@components/Organisms/Card/Review/Review.html.twig', review) }}
        {% endfor %}
    </div>
    {{ component('Flexy:Button', {
        href: button.href,
        text: button.label,
        icon_right: 'chevron-right',
        color: 'secondary',
        class: 'mt-5',
    }) }}

</div>
