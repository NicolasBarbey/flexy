<footer class="flex flex-col px-6 xl:px-[120px] py-6 xl:flex-row xl:justify-between FooterCheckout bg-theme-lightest gap-9
        md:gap-3 text-black">
    <ul class="flex flex-col gap-2 md:gap-6 md:flex-row">
        {% set footerLinkClass = 'underline hover:no-underline focus:no-underline hover:opacity-75 focus:opacity-75' %}
        {% set contents = resources('/api/front/contents', {'contentFolders.folder.id':attr('config','information_folder_id')}) %}

        {% for content in contents  %}
            <li class="paragraph-5">
                <a href="{{ content.publicUrl }}" class="{{ footerLinkClass }}">
                    {{ content.i18ns.title }}
                </a>
            </li>
        {% endfor %}
    </ul>
    <span class="text-grey indication indication-small">
        ©
        <a href="https://www.openstudio.fr/">
            OpenStudio
        </a>
        -
        {{ 'now'|date('Y') }}
    </span>
</footer>
