{#
 # Open Graph / Twitter Card helpers.
 #
 # `image` resolves the first image of a Thelia entity (product, category,
 # content, folder, page…) to an absolute URL, suitable for og:image and
 # twitter:image. Returns an empty string when the entity has no image, so
 # callers can fall back to the site default with the `?:` operator, e.g.
 #
 #   {% import '@components/Layout/Meta/SocialMeta.html.twig' as social %}
 #   {% block og_image %}{{ social.image('product', productId) ?: parent() }}{% endblock %}
 #}
{% macro image(source_type, source_id) %}
{%- set markup = getImages({
    source_id: source_id,
    source_type: source_type,
    filters: 'default',
    limit: 1,
}) -%}
{%- if markup and ' src="' in markup -%}
{{- absolute_url(markup|split(' src="')|last|split('"')|first) -}}
{%- endif -%}
{% endmacro %}
