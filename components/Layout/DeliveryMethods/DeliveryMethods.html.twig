<div class='flex flex-col gap-3.5 my-5'>
    {% if (deliveryModules.hasDelivery or deliveryModules.hasPickup or deliveryModules.hasLocalPickup) %}
        {% if deliveryModules.hasLocalPickup %}
            {% include '@components/Organisms/Modules/StoreDelivery/StoreDelivery.html.twig' with {
                name: 'delivery_method',
                title: 'Store delivery'|trans,
                date: 'TODO',
                address: {
                    address1: attr('config', 'store_address1'),
                    address2: attr('config', 'store_address2'),
                    address3: attr('config', 'store_address3'),
                    zipCode: attr('config', 'store_zipcode'),
                    city: attr('config', 'store_city')
                },
                selected : deliveryMode == enum('Thelia\\Core\\Enum\\DeliveryMode').LOCAL_PICKUP.value
            } %}
        {% endif %}
        {% if deliveryModules.hasPickup %}
            {% set pickupServices = deliveryModules.pickup|map((pickup) => {
                name:pickup.i18ns.title, 
                value: pickup.code, 
                img: ''}) 
            %}
            {% include '@components/Organisms/Modules/PickupPointModule/PickupPointModule.html.twig' with {
                title: 'Pick-up point'|trans,
                pickupServices,
                selected : deliveryMode == enum('Thelia\\Core\\Enum\\DeliveryMode').PICKUP.value
            } %}
        {% endif %}
        {% if deliveryModules.hasDelivery %}
            {% include '@components/Organisms/Modules/HomeDelivery/HomeDelivery.html.twig' with {
                title: 'Home Delivery'|trans,
                selected : deliveryMode == enum('Thelia\\Core\\Enum\\DeliveryMode').DELIVERY.value
            } %}
        {% endif %}
    {% else %}
        <div class="alert alert-warning">
            {{ "No delivery method is available for this order."|trans }}
        </div>
    {% endif %}
</div>
