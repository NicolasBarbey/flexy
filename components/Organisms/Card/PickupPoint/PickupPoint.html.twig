{% set title = title|default('') %}
{% set id = id|default('') %}
{% set date = date|default('') %}
{% set selected = selected|default(false) %}
{% set closed = closed|default(false) %}
{% set img = img|default(null) %}
{% set openingHours = openingHours|default([]) %}
{% set address = address|default({
    title: '',
    name: '',
    address1: '',
    zipCode: '',
    city: '',
}) %}
{% set days = ['monday'|trans, 'tuesday'|trans, 'wednesday'|trans, 'thursday'|trans, 'friday'|trans, 'saturday'|trans, 'sunday'|trans] %}

<div class="PickupPoint {% if selected %}selected{% endif %}">
    <label class="PickupPoint-content">
        {{ component('Flexy:RadioButton', {
            'data-action': 'live#action',
            'data-live-action-param': 'updateOption',
            'data-live-id-param': id,
            checked : selected
        }) }}

        <span>
            <span class="PickupPoint-title">
                {{ title }}
            </span>
            {% if date %}
                <span class="PickupPoint-description">
                    {{ 'Estimated delivery on'|trans }}
                    {{ date }}
                </span>
            {% endif %}

            <span class="PickupPoint-opening {% if closed %}closed{% endif %}">
                {% if closed %}
                    {{ 'Close'|trans }}
                {% else %}
                    {{ 'Open'|trans }}
                {% endif %}
                {{ 'currently'|trans }}
            </span>
            <span class="PickupPoint-address">
                <span>
                    {{ address.address1 }}
                    ,
                </span>
                {% if address.address2 %}
                    <span>
                        {{ address.address2 }}
                        ,
                    </span>
                {% endif %}
                <span>
                    {{ address.zipCode }}
                    {{ address.city }}
                </span>
            </span>

        </span>
    </label>
    <div class="PickupPoint-bottom" {{ stimulus_controller('store-delivery') }}>
        <div class="flex items-center gap-2">
            {{ ux_icon('clock',{class: 'w-4 h-4'}) }}
            {{ component('Flexy:Button', {
                class: 'DealerDelivery-hours',
                'data-show-hours': 'See opening hours'|trans,
                'data-hide-hours': 'hide opening times'|trans,
                'data-action': 'store-delivery#toggle',
                text: 'See opening hours'|trans,
                color: 'minimal',
            }) }}
        </div>
        <div class="PickupPoint-hoursListing md:hidden" data-store-delivery-target="list">
            <table>
                {% for i in 0..6 %}
                    <tr>
                        <td>
                            {{ days[i] }}
                        </td>
                        <td>
                            {% if openingHours[i] is not null %}
                                {{ openingHours[i]|replace({':00': 'h', ':': 'h'})|trim }}
                            {% else %}
                                fermé
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}

            </table>
        </div>
    </div>
    <div class="mt-4 md:hidden">
        {{ component('Flexy:Button', {
            text: 'Choose this relay point'|trans,
            liveEvent: 'forceCustomerDefaultDeliveryAddress',
            fill: true
        }) }}
    </div>
</div>
