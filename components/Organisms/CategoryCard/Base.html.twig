{% props id, title = '', href = '#' %}

<div class="{{ ('CategoryCard ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="CategoryCard-mainContent">
        <a class="CategoryCard-imgLink" href="{{ href }}">
            {% set image = getImages({
                source_id: id,
                source_type: 'category',
                filters: {'1024px': 'category', '768px': 'category_md', 'default': 'category_sm'},
                alt: ('Category'|trans) ~ ' ' ~ title,
                img_attrs: {loading: 'lazy', width: 190, height: 190},
                wrapper: 'picture',
                wrapper_attrs: {class: 'CategoryCard-img'},
                placeholder: asset('images/placeholder2.webp'),
                limit: 1,
            }) %}
            {{ image|raw }}
        </a>
        <div class="CategoryCard-desc">
            <span class="CategoryCard-title">{{ title }}</span>
            <div class="CategoryCard-footer">
                <twig:Molecules:Button:Base href="{{ href }}" text="{{ 'Discover'|trans }}" icon_right="chevron-right" />
            </div>
        </div>
    </div>
</div>
