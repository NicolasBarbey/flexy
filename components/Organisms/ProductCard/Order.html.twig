{% set pseImages = resources('/api/front/product_sale_elements_product_image', {'productSaleElementsId': this.orderProduct.productSaleElementsId, itemsPerPage: 1}) %}
{% if pseImages %}
	{% set imgId = pseImages|first.productImageId %}
{% else %}
	{% set productImages = resources('/api/front/product_images', {'product.id': this.orderProduct.productId, 'order[position]': 'asc', itemsPerPage: 1}) %}
	{% set imgId = productImages ? productImages|first.id : null %}
{% endif %}

<div class="ProductCard ProductCard--order">
	<div class="ProductCard-mainContent">
		<figure class="ProductCard-img">
			{% if imgId %}
				<img src="/legacy-image-library/product_image_{{ imgId }}/full/%5E*!224,224/0/default.webp" alt="{{ this.product.title }}" loading="lazy">
			{% else %}
				<img src="{{ asset('images/placeholder2.webp') }}" alt="" loading="lazy">
			{% endif %}
		</figure>
		<div class="ProductCard-desc">
			<a href="{{ this.product.publicUrl ~ '?ref=' ~ this.orderProduct.productSaleElementsRef }}" class="ProductCard-title">{{ this.product.title }}</a>
			<div class="ProductCard-orderInfos">
				<span class="ProductCard-secondaryTitle basis-full">{{ this.product.chapo }}</span>
				{% if this.pse %}
					{% for combination in this.pse.attributeCombinations %}
						<span class="ProductCard-secondarySize">{{ combination.attribute.i18ns.title }}: {{ combination.attributeAv.i18ns.title }}</span>
					{% endfor %}
				{% endif %}
				{% if this.orderProduct.quantity %}
					<span>{{ 'Quantity:'|trans }} {{ this.orderProduct.quantity }}</span>
				{% endif %}
			</div>
			{% if this.orderProduct.wasInPromo %}
				<div class="ProductCard-footer">
					<div class="ProductCard-price">{{ this.orderProduct.promoPrice|format_currency('EUR', locale: lang_code) }}</div>
					<div class="ProductCard-originalPrice">{{ this.orderProduct.price|format_currency('EUR', locale: lang_code) }}</div>
				</div>
			{% else %}
				<div class="ProductCard-price">{{ this.orderProduct.price|format_currency('EUR', locale: lang_code) }}</div>
			{% endif %}
		</div>
	</div>
</div>
