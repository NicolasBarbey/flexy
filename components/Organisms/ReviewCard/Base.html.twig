{% props author = '', review = '', date = '', note = 0, maxNote = 5 %}

<div class="{{ ('ReviewCard ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="ReviewCard-author">{{ author }}</div>
    <div class="ReviewCard-review">{{ review }}</div>
    <div class="ReviewCard-footer">
        <twig:Molecules:Score:Base score="{{ note }}" maxScore="{{ maxNote }}" />
        <div class="ReviewCard-date">{{ date }}</div>
    </div>
</div>
