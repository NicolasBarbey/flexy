<div class="HeaderNav">
    {{ component('Flexy:LangSelect') }}

    {% if isAuthenticatedFront() %}
        {{ component('Flexy:HeaderProfile') }}
    {% else %}
        {{ component('Flexy:HeaderButton', {
            href: path('account_index'),
            icon: 'account',
            color: 'theme',
            class: "HeaderNav-btn",
            text: 'Account'|trans,
            small: true
        }) }}
    {% endif %}

    {{ component('Flexy:HeaderButton', {
        href: path('checkout_cart'),
        icon: 'cart',
        color: 'dark',
        class: "HeaderNav-btn",
        text: 'Cart'|trans,
        small: true
    }) }}
    {{ component('Flexy:HeaderButton', {
        href: path('checkout_cart'),
        icon: 'menu',
        color: 'light',
        id: 'toggleMenu',
        class: "HeaderNav-btn lg:hidden",
        text: 'Cart'|trans,
        small: true,
        'data-header-target': "toggler"
    }) }}
</div>
