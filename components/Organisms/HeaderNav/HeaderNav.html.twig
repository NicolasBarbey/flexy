<div class='HeaderNav'>
	{{ component('Flexy:Molecules:LangSelect') }}

	{% if isAuthenticatedFront() %}
		{% include '@components/Molecules/HeaderButton/HeaderButtonProfile.html.twig' %}
	{% else %}
		{% include '@components/Molecules/HeaderButton/HeaderButton.html.twig' with { link: path('account_index'), icon: 'account', classes: 'HeaderNav-btn HeaderButton--theme', text: 'Account'|trans, small: true } %}
	{% endif %}


	{% include '@components/Molecules/HeaderButton/HeaderButton.html.twig' with { icon: 'cart', link:'/checkout/cart', text: 'Cart'|trans, classes: 'HeaderNav-btn HeaderButton--dark ', small: true} %}
	{% include '@components/Molecules/HeaderButton/HeaderButton.html.twig' with { icon: 'menu', id: "toggleMenu", classes: 'HeaderNav-btn HeaderButton--light lg:hidden', text: 'Menu'|trans, small: true, target: "toggler" } %}
</div>
