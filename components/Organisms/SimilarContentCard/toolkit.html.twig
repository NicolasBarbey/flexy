{% set content = resources('/api/front/contents/1') %}

<div class="grid gap-4">
    <h4>Base</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-lightest p-4 rounded-md">

        <div class="grid gap-2 content-start">
            <span class="text-xs text-grey">real data (content #1 — image falls back to placeholder unless one was added in the BO)</span>
            <twig:Organisms:SimilarContentCard:Base
                id="1"
                title="{{ content.i18ns.title|default('Care instructions') }}"
                date="{{ content.createdAt|default('2026-01-15') }}"
                url="{{ content.publicUrl|default('/content/1') }}"
            />
        </div>

        <div class="grid gap-2 content-start">
            <span class="text-xs text-grey">manual data, no matching content (placeholder image)</span>
            <twig:Organisms:SimilarContentCard:Base id="99999" title="How to choose your size" date="2026-02-03" url="/content/99999" />
        </div>

    </div>
</div>
