<div class="OrderProductCard">
  <div class="OrderProductCard-mainContent">
    <figure class="OrderProductCard-img">
      <img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
    </figure>
    <div class="OrderProductCard-desc">
      <div class="OrderProductCard-title">{{ productTitle }}</div>


      <div class="OrderProductCard-orderInfos paragraph-6">
        <span class="OrderProductCard-secondaryTitle">{{ secondaryTitle }}</span>
        {% for attribute,value in attributesAv %}
          <span class="OrderProductCard-secondarySize">{{ attribute }}
								:
								{{ value }}</span>
        {% endfor %}
        {% if quantity %}
          <span>{{ 'Quantity:' |trans }}
            {{ quantity }}</span>
        {% endif %}

        {% if attributesAvColor %}

          <span class="flex items-center OrderProductCard-secondarySize">
								<span class="mr-1 Colors-item" style="background-color:{{ attributesAvColor.hexa }}"></span>
								{{ t('Color') }}:
								{{ attributesAvColor.name }}</span>
        {% endif %}
      </div>
      {% if isPromo %}
        <div class="OrderProductCard-footerRight">
          <div class="OrderProductCard-price">{{ promoPrice }}</div>
          <div class="OrderProductCard-originalPrice">{{ price }}</div>
        </div>
      {% else %}
        <div class="OrderProductCard-price">{{ price }}</div>
      {% endif %}
    </div>
  </div>
</div>
