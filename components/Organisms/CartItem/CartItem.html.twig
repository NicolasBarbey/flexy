{% if cartItem %}
  {% set outOfStock = outOfStock|default(cartItem.productSaleElements.quantity <= 0) %}
  {% set product = cartItem.product %}
  {% set secondaryTitle = product.i18ns.chapo %}

  {% if imageId is defined %}
    {% set img = {url: '/legacy-image-library/product_image_'~ imageId ~'/full/%5E*!386,280/0/default.webp', alt: product.i18ns.title} %}
  {% else %}
    {% set img = img|default({url: asset('dist/images/placeholder2.webp'), alt:'Default image'|trans}) %}
  {% endif %}

  <div class='{{ outOfStock ? 'CartItem-outOfStock' :'' }}' {{ attributes }}>
    {% if outOfStock %}
      <div class='paragraph-4 flex'>
        <span class='w-5 h-5'>{{ ux_icon("error") }}</span>
        <span>[{{ title }}] {{ 'is no longer available and cannot be ordered.' |trans }}</span>
      </div>
    {% endif %}
    <div class="CartItem {{ classes }}">
      <div class="CartItem-mainContent">
        <a class="CartItem-imgLink" href="{{ product.publicUrl }}">
          <figure class="CartItem-img">
            <img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
          </figure>
        </a>
        <div class="CartItem-desc">
          <a href="{{ product.publicUrl }}" class="ProductCard-title">{{ product.i18ns.title }}</a>

          {% if secondaryTitle %}
            <div class="CartItem-subTitle paragraph-3 block md:hidden">{{ secondaryTitle }}</div>
          {% endif %}
          <div class="CartItem-orderInfos paragraph-6">

            {% if secondaryTitle %}
              <span class="CartItem-secondaryTitle md:inline hidden">{{ secondaryTitle }}</span>
            {% endif %}
            {% for attribute,value in attributesAv %}
              <span class="CartItem-secondarySize">{{ attribute }}
								:
								{{ value }}</span>
            {% endfor %}
            {% if cartItem.quantity %}
              <span>{{ 'Quantity:' |trans }}
                {{ cartItem.quantity }}</span>
            {% endif %}

            {% if attributesAvColor %}

              <span class="flex items-center CartItem-secondarySize">
								<span class="mr-1 Colors-item" style="background-color:{{ attributesAvColor.hexa }}"></span>
								{{ t('Color') }}:
								{{ attributesAvColor.name }}</span>
            {% endif %}
          </div>


          <div class="CartItem-footer">
            {% if isPromo %}
              <div class="CartItem-footerRight">
                <div class="CartItem-price">{{ promoPrice }}</div>
                <div class="CartItem-originalPrice">{{ price }}</div>
              </div>
            {% else %}
              <div class="CartItem-price">{{ price }}</div>
            {% endif %}


            {% if outOfStock %}
              <div class="CartItem-unavailable">
                {{ 'Unavailable' |trans }}
              </div>
            {% else %}
              <div class="CartItem-quantity">
                {% include '@components/Molecules/Button/Quantity.html.twig' with {disabled: false, value:cartItem.quantity, classes:'Button--small'} %}
              </div>
            {% endif %}

          </div>
        </div>
      </div>

      <div class="bottom-card-buttons">
        <a href='{{ product.publicUrl }}' class='hover:bg-theme-lighter' {% if disabled %} disabled {% endif %}
           type='button'>
          <span>{{ ux_icon("show") }}</span>
          {{ 'View product'|trans }}
        </a>
        <button
          class='hover:bg-theme-lighter'
          {% if disabled %} disabled {% endif %}
          type='button'
          data-action="live#emit"
          data-live-event-param="removeCartItem"
          data-live-id-param="{{ cartItem.id }}"
          {#          data-action="live#action" #}
          {#          data-live-action-param="saveProduct" #}
        >
          <span>{{ ux_icon("delete") }}</span>
          {{ 'Delete' |trans }}
        </button>
      </div>

    </div>
    {% if outOfStock %}
      <div class='flex md:justify-end'>
        {% include '@components/Molecules/Button/Button.html.twig' with {text: 'View similar products' |trans, href: '#', classes:'md:Button--unfill Button--fill'} %}
      </div>
    {% endif %}
  </div>
{% endif %}
