<div
  class='CartItemDelete {% if not cartItemId %}hidden{% endif %}' {{ attributes.defaults(stimulus_controller('cartitem')) }}>
  {% if cartItemId %}
    {% if imageId is defined %}
      {% set img = {url: '/legacy-image-library/product_image_'~ imageId ~'/full/%5E*!386,280/0/default.webp', alt: product.i18ns.title} %}
    {% else %}
      {% set img = img|default({url: asset('dist/images/placeholder2.webp'), alt:'Default image'|trans}) %}
    {% endif %}
    <button class='CartItemDelete-iconClose'>{{ ux_icon("close") }}</button>
    <div class="CartItemDelete-mainContent">
      <figure class="CartItemDelete-img">
        <img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
      </figure>
      <div class="CartItemDelete-desc">
        <div class="CartItemDelete-message">
          {{ title }}
          {{ 'has been removed from your cart.' |trans }}
        </div>
        {% include '@components/Molecules/Button/Button.html.twig' with {classes:'Button--small', text: 'Restore'|trans , icon_left: "restore", props: {'data-action': "click->cartitem#cancelDelete"} } %}
      </div>
    </div>
    <div class="CartItemDelete-progressBar">
      <div class="CartItemDelete-progressBarInner" style='--duration: {{ timer }}s;'></div>
    </div>
  {% endif %}

</div>
