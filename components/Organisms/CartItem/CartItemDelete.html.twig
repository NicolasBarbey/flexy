<div
  class='CartItemsDelete {% if cartItems|length <= 0 %}hidden{% endif %}' {{ attributes.defaults(stimulus_controller('cartitem')) }}>
  {% for cartItem in cartItems %}
    {% set cartItemId = cartItem.id %}
    {% set title = cartItem.title %}
    {% set productId = cartItem.productId %}
    {% set product_image_params = {
       'source_type': 'product',
            'source_id': productId,
            'filters': 'default',
              'wrapper': 'figure',
               'wrapper_attrs':{
              'class':'CartItemDelete-img'
            },
            'position': 1,
            'img_attrs': {
                'loading': 'lazy'
            },
            'placeholder': asset('dist/images/placeholder2.webp')
  } %} 
  {% set productImage = getImages(product_image_params) %}
    <div class='CartItemDelete '>
      {% if cartItemId %}
        <button class='CartItemDelete-iconClose'>{{ ux_icon("close") }}</button>
        <div class="CartItemDelete-mainContent">
         {{productImage|raw}}
          <div class="CartItemDelete-desc">
            <div class="CartItemDelete-message">
              {{ title }}
              {{ 'has been removed from your cart.' |trans }}
            </div>
            {% include '@components/Molecules/Button/Button.html.twig' with {classes:'Button--small', text: 'Restore'|trans , icon_left: "restore", props: {'data-action': "click->cartitem#cancelDelete", "data-cartitem-id-param":cartItemId} } %}
          </div>
        </div>
        <div class="CartItemDelete-progressBar">
          <div class="CartItemDelete-progressBarInner" style='--duration: {{ timer }}s;'></div>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
