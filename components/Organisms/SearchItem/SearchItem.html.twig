{% set direction = "SearchItem--horizontal" %}

{% if vertical %}
  {% set direction = "SearchItem--vertical" %}
{% endif %}

<a class="SearchItem {{ direction }}" href='{{ publicUrl|default('#') }}'>
  <div class="SearchItem-mainContent">
    <figure class="SearchItem-img">
      <img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
    </figure>
    <div class="SearchItem-desc">
      <div href="{{ productLink }}" class="SearchItem-title">{{ productTitle }}</div>

      <div class="SearchItem-footer">
        {% if isPromo %}
          <div class="SearchItem-pricePromo">
            <div class="SearchItem-price">{{ promoPrice }}</div>
            <div class="SearchItem-originalPrice">{{ price }}</div>
          </div>
        {% else %}
          <div class="SearchItem-price">{{ price }}</div>
        {% endif %}
      </div>
    </div>

  </div>
</a>
