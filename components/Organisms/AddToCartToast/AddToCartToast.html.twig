{% if imageId is defined %}
  {% set img = {url: '/legacy-image-library/product_image_'~ imageId ~'/full/%5E*!386,280/0/default.webp', alt: product.i18ns.title} %}
{% else %}
  {% set img = img|default({url: asset('dist/images/placeholder2.webp'), alt:'Default image'|trans}) %}
{% endif %}

<div class="AddToCartToast {% if not pseId %}hidden{% endif %}" {{ attributes }}>
  <button class='AddToCartToast-iconClose' data-action="live#action"
          data-live-action-param="closeToast">{{ ux_icon("close") }}</button>
  <p class="AddToCartToast-message">
    {{ 'Your product has been added to the cart' |trans }}
  </p>

  <div class="AddToCartToast-mainContent">
    <a class="AddToCartToast-imgLink" href="{{ productLink }}">
      <figure class="AddToCartToast-img">
        <img src="{{ img.url }}" alt="{{ img.alt }}" title="{{ img.alt }}" loading="lazy">
      </figure>
    </a>
    <div class="AddToCartToast-desc">
      <a href="{{ productLink }}" class="AddToCartToast-title">{{ title }}</a>

      <div class="AddToCartToast-infos paragraph-6">
        {% if secondaryTitle %}
          <span class="AddToCartToast-secondaryTitle">{{ secondaryTitle }}</span>
        {% endif %}
        {% for attribute,value in attributesAv %}
          <span class="AddToCartToast-secondarySize">{{ attribute }}
								:
								{{ value }}</span>
        {% endfor %}
        {% if quantity %}
          <span>{{ 'Quantity:' |trans }}
            {{ quantity }}</span>
        {% endif %}

        {% if attributesAvColor %}
          <span class="flex items-center AddToCartToast-secondarySize">
								<span class="mr-1 Colors-item" style="background-color:{{ attributesAvColor.hexa }}"></span>
								{{ t('Color') }}:
								{{ attributesAvColor.name }}</span>
        {% endif %}
      </div>


      <div class="AddToCartToast-footer">
        {% if rate != null or colors|length > 0 %}
          <div class="AddToCartToast-footerLeft">
            {% if rate != null %}
              <div class="Rating">
                <div class="Rating-mark">
                  {% for i in 1..5 %}
                    {% if rate >= i %}
                      <div>
                        {{ ux_icon("star-full") }}
                      </div>
                    {% elseif rate <= i and rate > i - 1 %}
                      <div>
                        {{ ux_icon("star-half-empty") }}
                      </div>
                    {% else %}
                      <div class="star-empty">
                        {{ ux_icon("star-full") }}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
                <span class="Rating-reviewCount indication-small">
										{{ reviewCount }}
                  {{ 'Reviews' |trans }}
									</span>
              </div>
            {% endif %}
            {% if hasColors %}
              <div class="Colors">
                {% set limit = 6 %}
                {% for color in colors %}
                  {% if loop.index0 < limit %}
                    <a href="#" class="Colors-item" style="background-color:{{ color }}"></a>
                  {% else %}
                    <div class="Colors-others">...</div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if isPromo %}
          <div class="AddToCartToast-footerRight">
            <div class="AddToCartToast-price">{{ promoPrice }}</div>
            <div class="AddToCartToast-originalPrice">{{ price }}</div>
          </div>
        {% else %}
          <div class="AddToCartToast-price">{{ price }}</div>
        {% endif %}
      </div>
    </div>
  </div>


  <div class="AddToCartToast-bottom">
    {% include '@components/Molecules/Button/Button.html.twig' with {classes:'Button--medium', variant: "primary", text: "View my cart"|trans, liveAction: 'viewCart' } %}
    {% include '@components/Molecules/Button/Button.html.twig' with {classes:'Button--medium', variant: "secondary", text: "Continue shopping"|trans, liveAction: 'closeToast' } %}
  </div>
</div>
