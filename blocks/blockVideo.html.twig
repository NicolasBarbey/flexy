{% if data.videoId %}
<div class="tb-{{ type.id }} aspect-video">
    <iframe
        class="w-full h-full"
        src="https://www.youtube.com/embed/{{ data.videoId }}"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
    ></iframe>
</div>
{% endif %}
