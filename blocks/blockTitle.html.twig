{% if data.text %}
    {% if data.level %}
        <h{{ data.level }} class="tb-{{ type.id }}" id="{{ data.text|slug_id(id) }}">{{ data.text|raw }}</h{{ data.level }}>
    {% else %}
        <p class="tb-{{ type.id }}" id="{{ data.text|slug_id(id) }}">{{ data.text|raw }}</p>
    {% endif %}
{% endif %}
