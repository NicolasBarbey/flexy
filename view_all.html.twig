{% extends 'base.html.twig' %}
{% set page = app.request.get('page')|default(1) %}
{% set type = app.request.get('type')|default("sales") %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('category-css') }}
{% endblock %}

{% block stimulus_controller %}
    {{ stimulus_controller('drawer') }}
{% endblock %}

{% block title %}
  {{ 'view_all'|trans }}
{% endblock %}

{% block body %}
    {% set breadcrumb = [{
        title: "view_all"|trans,
        href: "/view_all"
    }] %}

    {% set i18ns = {
        title: "view_all"|trans
    } %}

    {% if type == "promo" %}
        {% set breadcrumb = [{
            title: "view_all_promo"|trans,
            href: "/view_all?type=promo"
        }] %}

        {% set i18ns = {
            title: "Promotions"|trans
        } %}
    {% endif %}

    {% if type == "newness" %}
        {% set breadcrumb = [{
            title: "view_all_newness"|trans,
            href: "/view_all?type=newness"
        }] %}

        {% set i18ns = {
            title: "New"|trans
        } %}
    {% endif %}

    {{ component('Flexy:CatHero', {
        breadcrumb,
        i18ns,
        title: i18ns.title,
        noImage: true
    }) }}

    {{ component('Flexy:CategoryFilters', {
      initialCategoryId: null,
      initialPage: page,
      parent: null,
      initSearchQuery: null,
      sourceData: {},
      promo: type == "promo",
      newness: type == "newness",
    })}}
{% endblock %}
