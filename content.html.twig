{% extends 'base.html.twig' %}

{% block body %}

	{% set ps = attr('content', 'postscriptum') %}

	{{ include('@components/Layout/Subheader/ContentPage/SubheaderContentPage.html.twig',{
        title: attr('content', 'title'),
        description: attr('content', 'chapo'),
        id: attr('content', 'id'),
    })}}

	<div class="container flex gap-[173px] pt-[25px] lg:pt-[54px] pb-[80px] lg:pb-[120px]">
		<article class="wysiwyg">
			<div>
				{{ attr('content', 'description') }}
			</div>
			{{ component('Flexy:Blocks', {item_type: 'content', item_id: attr('content', 'id')}) }}
			{% if ps %}
				<small>{{ ps }}</small>
			{% endif %}

		</article>
	</div>

	<div class="bg-theme-lighter">
		{{
            component('Flexy:SimilarContent', {
                title: 'On the same topic'|trans,
                button: {
                    label: 'See all news'|trans,
                    href: '/'
                },
            })
        }}
	</div>
{% endblock %}
