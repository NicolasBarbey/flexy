{% extends 'base.html.twig' %}

{% block title %}{{ 'Forgot password?'|trans }}{% endblock %}

{% block body %}
    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        <h2 class="h2 text-black mb-4">{{ 'Forgot password?'|trans }}</h2>

        {% if app.request.query.get('resend_success') %}
            <twig:Molecules:SnackBar:Base variant="success" text="{{ 'A link has just been sent to your email address.'|trans }}" />
        {% else %}
            <twig:Molecules:SnackBar:Base variant="success" text="{{ 'If your account exists, a link has just been sent to your e-mail address. Please check your inbox.'|trans }}" />
        {% endif %}

        <p class="paragraph-2 text-black mt-6 mb-2">{{ 'Remember to check your spam, then try to resend the e-mail.'|trans }}</p>
        <twig:Molecules:Link:Base href="{{ path('password_resend') }}" customText="{{ 'resend e-mail'|trans }}" />

        <hr class="my-10" />

        <twig:Molecules:Link:Base href="{{ path('customer_login') }}" customText="{{ 'Back to login'|trans }}" />
    </div>
{% endblock %}
