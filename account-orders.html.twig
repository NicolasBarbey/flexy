{% extends 'base.html.twig' %}

{% block title %}{{ 'My orders'|trans }}{% endblock %}

{% block body %}
    <twig:Layouts:Subheader:Account
        title="{{ 'My orders'|trans }}"
        selected="orders"
        :breadcrumb="[
            {title: 'My account'|trans, url: path('account_index')},
            {title: 'My orders'|trans},
        ]"
    />

    <div class="container-l pt-6 pb-20 md:pt-11 md:pb-30">
        <twig:Layouts:AccountOrders:Base :page="app.request.query.getInt('page', 1)" />
    </div>
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
