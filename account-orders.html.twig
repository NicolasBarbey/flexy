{% extends 'base.html.twig' %}
{% set orders = resources('/api/front/account/orders', {
    'customer.id': attr('customer', 'id'),
    'order[createdAt]' : 'desc'
}) %}

{% block title %}
    {{ 'My orders'|trans }}
{% endblock %}

{% block body %}
    {{ component('Flexy:AccountHero', {
        title: 'My orders'|trans,
        selected: "orders",
        breadcrumb: [
            {
                title: 'My account'|trans,
                url: path('account_index')
            },
            {
                title: 'My orders'|trans
            }]
    }) }}
    {% if orders|length %}
        <div class="container flex justify-center">
            <div class="grid max-w-[616px] w-full gap-6 mx-auto mt-2 md:mt-11 mb-[80px] md:mb-[120px]">
                {% for order in orders %}
                    {{ component('Flexy:OrderCard', {orderId: order.id}) }}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="flex flex-col items-center justify-center mb-20 text-center mt-11 lg:mt-12">
            <div class="w-[135px] h-[140px] lg:w-[244px] lg:h-[253px]">
                {{ source('assets/images/nothing.svg') }}
            </div>
            <h3 class="mt-4 mb-6 h3">{{ 'You have no orders yet'|trans }}</h3>
        </div>
    {% endif %}

{% endblock %}

{% block footer %}
    {{ include('@components/Layout/Footer/FooterCheckout.html.twig') }}
{% endblock %}
